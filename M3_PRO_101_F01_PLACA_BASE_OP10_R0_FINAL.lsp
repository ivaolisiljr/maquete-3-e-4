(defun M3P101F01:lay (n c lt w) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 w)))))
(defun M3P101F01:ln (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P101F01:tx (p h t l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 t) (cons 7 "Standard"))))
(defun M3P101F01:rc (x1 y1 x2 y2 l) (M3P101F01:ln (list x1 y1 0) (list x2 y1 0) l) (M3P101F01:ln (list x2 y1 0) (list x2 y2 0) l) (M3P101F01:ln (list x2 y2 0) (list x1 y2 0) l) (M3P101F01:ln (list x1 y2 0) (list x1 y1 0) l))
(defun M3P101F01:arr (p1 p2 l / a q1 q2) (M3P101F01:ln p1 p2 l) (setq a (angle p1 p2) q1 (polar p2 (+ a 2.65) 4.0) q2 (polar p2 (- a 2.65) 4.0)) (M3P101F01:ln p2 q1 l) (M3P101F01:ln p2 q2 l))
