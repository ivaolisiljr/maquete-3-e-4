; Uma folha A3 / AutoCAD Mechanical 2025 PT-BR / mm
; Comandos: M3_ASM_101_GERAR e M3_ASM_101_AUDITAR
; Componentes: P401, P402, P403-P405, P406(6), P302-P304, P503, fixadores M5.
(vl-load-com)
(setq *M3A101-OLDERR* nil *M3A101-OLDVARS* nil)
(defun M3A101:savevars () (setq *M3A101-OLDVARS* (mapcar '(lambda(n)(cons n(getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3A101:restorevars () (if *M3A101-OLDVARS* (foreach p *M3A101-OLDVARS* (if (cdr p)(setvar(car p)(cdr p))))) (setq *M3A101-OLDVARS* nil))
(defun M3A101:error(m)(M3A101:restorevars)(if(and m(/= m "Function cancelled"))(princ(strcat "\nM3-ASM-101 ERRO: " m)))(setq *error* *M3A101-OLDERR*)(princ))
(defun M3A101:layer(n c lt lw)(if(not(tblsearch "LAYER" n))(entmake(list '(0 . "LAYER")'(100 . "AcDbSymbolTableRecord")'(100 . "AcDbLayerTableRecord")(cons 2 n)(cons 70 0)(cons 62 c)(cons 6 lt)(cons 370 lw)))))
(defun M3A101:line(a b l)(entmake(list '(0 . "LINE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbLine")(cons 10 a)(cons 11 b))))
(defun M3A101:circle(c r l)(entmake(list '(0 . "CIRCLE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbCircle")(cons 10 c)(cons 40 r))))
(defun M3A101:text(p h x l)(entmake(list '(0 . "TEXT")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbText")(cons 10 p)(cons 40 h)(cons 1 x)(cons 7 "Standard"))))
(defun M3A101:rect(x1 y1 x2 y2 l)(M3A101:line(list x1 y1 0)(list x2 y1 0)l)(M3A101:line(list x2 y1 0)(list x2 y2 0)l)(M3A101:line(list x2 y2 0)(list x1 y2 0)l)(M3A101:line(list x1 y2 0)(list x1 y1 0)l))
