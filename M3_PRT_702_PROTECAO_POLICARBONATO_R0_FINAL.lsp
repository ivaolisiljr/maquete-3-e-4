; M3-PRT-702 - PROTECAO TRANSPARENTE - R0 FINAL DE PROTOTIPO
; M3-PLN / A3 horizontal / mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_702_GERAR e M3_PRT_702_AUDITAR
; P0: policarbonato compacto 4 mm, desenvolvimento 240 x 180;
; dobrado em U: topo 160, abas 40; comprimento 180; 6 rasgos 5.5 x 12 para M5.
(vl-load-com)
(setq *M3P702-OLDERR* nil *M3P702-OLDVARS* nil)
(defun M3P702:savevars () (setq *M3P702-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3P702:restorevars () (if *M3P702-OLDVARS* (foreach p *M3P702-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P702-OLDVARS* nil))
(defun M3P702:error (m) (M3P702:restorevars) (if (and m (/= m "Function cancelled")) (princ (strcat "\nM3-PRT-702 ERRO: " m))) (setq *error* *M3P702-OLDERR*) (princ))
(defun M3P702:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P702:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P702:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P702:text (p h x l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 x) (cons 7 "Standard"))))
(defun M3P702:rect (x1 y1 x2 y2 l) (M3P702:line (list x1 y1 0) (list x2 y1 0) l) (M3P702:line (list x2 y1 0) (list x2 y2 0) l) (M3P702:line (list x2 y2 0) (list x1 y2 0) l) (M3P702:line (list x1 y2 0) (list x1 y1 0) l))
(defun M3P702:slot (c len wid l / x y h r) (setq x (car c) y (cadr c) h (/ (- len wid) 2.0) r (/ wid 2.0)) (M3P702:line (list (- x h) (- y r) 0) (list (+ x h) (- y r) 0) l) (M3P702:line (list (- x h) (+ y r) 0) (list (+ x h) (+ y r) 0) l) (M3P702:circle (list (- x h) y 0) r l) (M3P702:circle (list (+ x h) y 0) r l))
