 ; impact and revision
 (M3D001:rect 25 78 235 128 "M3D001-TABELA")(M3D001:text '(30 121 0)4.5"ARQUIVOS QUE DEVEM SER REVISADOS""M3D001-TEXTO")
 (M3D001:text '(30 113 0)3"P401/P402: 4 FUROS DE PINOS A 90 GRAUS.""M3D001-TEXTO")
 (M3D001:text '(30 106 0)3"ADICIONAR P307 PLANETA 4 E P407 PINO 4.""M3D001-TEXTO")
 (M3D001:text '(30 99 0)3"P406: QUANTIDADE PASSA DE 6 PARA 8.""M3D001-TEXTO")
 (M3D001:text '(30 92 0)3"ASM-101/301 E BOM: ATUALIZAR PARA 4 PLANETAS.""M3D001-TEXTO")
