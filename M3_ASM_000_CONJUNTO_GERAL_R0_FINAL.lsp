(defun C:M3_ASM_000_GERAR(/ ss)
 (M3G000:savevars)(setq *M3G000-OLDERR* *error* *error* M3G000:error)(setvar "CMDECHO" 0)(setvar "OSMODE" 0)(setvar "ORTHOMODE" 0)(setvar "INSUNITS" 4)
 (foreach x '(("M3G000-MARGEM" 7 "Continuous" 50)("M3G000-CARIMBO" 7 "Continuous" 25)("M3G000-BASE" 7 "Continuous" 50)("M3G000-PEDESTAL" 6 "Continuous" 50)("M3G000-CARCACA" 8 "Continuous" 50)("M3G000-INTERNO" 8 "Continuous" 25)("M3G000-EIXO" 4 "CENTER2" 25)("M3G000-MANIVELA" 2 "Continuous" 50)("M3G000-PROTECAO" 3 "Continuous" 25)("M3G000-COROA" 2 "Continuous" 50)("M3G000-SOLAR" 1 "Continuous" 50)("M3G000-PLANETA" 3 "Continuous" 50)("M3G000-PORTA" 5 "Continuous" 50)("M3G000-TEXTO" 7 "Continuous" 25)("M3G000-TABELA" 7 "Continuous" 25)) (M3G000:layer(car x)(cadr x)(caddr x)(cadddr x)))
 (setq ss(ssget "X" '((8 . "M3G000-*"))))(if ss(command "_.ERASE" ss ""))(M3G000:draw)(command "_.ZOOM" "_E")(M3G000:restorevars)(setq *error* *M3G000-OLDERR*)
 (princ "\nM3-ASM-000 R0 gerada. Execute M3_ASM_000_AUDITAR.")(princ))
(defun C:M3_ASM_000_AUDITAR(/ ss n ok)
 (setq ss(ssget "X" '((8 . "M3G000-*"))) n(if ss(sslength ss)0))(setq ok(and(> n 85)(tblsearch "LAYER" "M3G000-PROTECAO")(tblsearch "LAYER" "M3G000-PLANETA")))
 (princ "\n--- AUDITORIA M3-ASM-000 ---")(princ(strcat "\nEntidades: "(itoa n)))(princ "\nConjunto: base, pedestais, redutor 4 planetas, eixos, manivela e protecao.")
 (if ok(princ "\nRESULTADO ESTATICO: APROVADO COMO PROTOTIPO P0.")(princ "\nRESULTADO: REPROVADO."))(princ))
(princ "\nM3-ASM-000 carregada. Comandos: M3_ASM_000_GERAR e M3_ASM_000_AUDITAR.")(princ)
