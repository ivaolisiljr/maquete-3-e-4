; M3-PRT-402 - PLACA PORTA-PLANETAS TRASEIRA - R1
; Projeto M3-PLN - redutor planetario didatico 4:1
; AutoCAD Mechanical 2025 PT-BR / folha A3 horizontal / mm
; Comandos: M3_PRT_402_GERAR e M3_PRT_402_AUDITAR
; Geometria P0: disco OD90 x 6; 4 furos 10 H7 no PCD60 a 90 graus;
; furo central 25 H7 para cubo; 3 furos M5 no PCD40 para uniao ao cubo.
(vl-load-com)
(setq *M3P402-OLDERR* nil *M3P402-OLDVARS* nil)
(defun M3P402:savevars ()
  (setq *M3P402-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n)))
    '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "LTSCALE" "CELTSCALE" "INSUNITS"))))
(defun M3P402:restorevars ()
  (if *M3P402-OLDVARS* (foreach p *M3P402-OLDVARS* (if (cdr p) (setvar (car p) (cdr p)))))
  (setq *M3P402-OLDVARS* nil))
(defun M3P402:error (msg)
  (M3P402:restorevars)
  (if (and msg (/= msg "Function cancelled") (/= msg "quit / exit abort"))
    (princ (strcat "\nM3-PRT-402 ERRO: " msg)))
  (setq *error* *M3P402-OLDERR*) (princ))
(defun M3P402:layer (n c lt lw)
  (if (not (tblsearch "LAYER" n))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
      '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c)
      (cons 6 lt) (cons 370 lw)))))
(defun M3P402:line (a b l)
  (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P402:circle (c r l)
  (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P402:text (p h tx l j / d)
  (setq d (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 tx) (cons 7 "Standard") (cons 50 0.0)))
  (if (= j "MC") (setq d (append d (list (cons 72 1) (cons 73 2) (cons 11 p))))
    (setq d (append d (list (cons 72 0) (cons 73 2) (cons 11 p)))))
  (entmake d))
(defun M3P402:rect (x1 y1 x2 y2 l)
  (M3P402:line (list x1 y1 0.0) (list x2 y1 0.0) l)
  (M3P402:line (list x2 y1 0.0) (list x2 y2 0.0) l)
  (M3P402:line (list x2 y2 0.0) (list x1 y2 0.0) l)
  (M3P402:line (list x1 y2 0.0) (list x1 y1 0.0) l))
(defun M3P402:center (c r)
  (M3P402:line (polar c pi (+ r 4.0)) (polar c 0.0 (+ r 4.0)) "M3P402-EIXO")
  (M3P402:line (polar c (* 1.5 pi) (+ r 4.0)) (polar c (/ pi 2.0) (+ r 4.0)) "M3P402-EIXO"))
(defun M3P402:arrow (p a s l)
  (M3P402:line p (polar p (+ a 2.65) s) l) (M3P402:line p (polar p (- a 2.65) s) l))
(defun M3P402:dimH (x1 x2 yo yd tx / a b)
  (setq a (list x1 yd 0.0) b (list x2 yd 0.0))
  (M3P402:line (list x1 yo 0.0) a "M3P402-COTA")
  (M3P402:line (list x2 yo 0.0) b "M3P402-COTA")
  (M3P402:line a b "M3P402-COTA")
  (M3P402:arrow a 0.0 2.0 "M3P402-COTA") (M3P402:arrow b pi 2.0 "M3P402-COTA")
  (M3P402:text (list (/ (+ x1 x2) 2.0) (+ yd 2.5) 0.0) 3.5 tx "M3P402-TEXTO" "MC"))
(defun M3P402:hatch (x1 y1 x2 y2 st / x)
  (setq x (- x1 (- y2 y1)))
  (while (< x x2)
    (M3P402:line (list (max x1 x) (+ y1 (max 0.0 (- x1 x))) 0.0)
      (list (min x2 (+ x (- y2 y1))) (min y2 (+ y1 (- x2 x))) 0.0) "M3P402-HACHURA")
    (setq x (+ x st))))
(defun M3P402:frame ()
  (M3P402:rect 10.0 10.0 410.0 287.0 "M3P402-MARGEM")
  (M3P402:rect 20.0 20.0 400.0 277.0 "M3P402-MARGEM")
  (M3P402:rect 245.0 20.0 400.0 70.0 "M3P402-CARIMBO")
  (foreach y '(30.0 40.0 50.0 60.0) (M3P402:line (list 245.0 y 0.0) (list 400.0 y 0.0) "M3P402-CARIMBO"))
  (M3P402:line '(315.0 20.0 0.0) '(315.0 60.0 0.0) "M3P402-CARIMBO")
  (M3P402:text '(248.0 65.0 0.0) 3.5 "CENTRO PAULA SOUZA / ETEC" "M3P402-TEXTO" "ML")
  (M3P402:text '(248.0 55.0 0.0) 3.5 "PROJETO: M3-PLN REDUTOR EPICICLICO 4:1" "M3P402-TEXTO" "ML")
  (M3P402:text '(248.0 45.0 0.0) 3.5 "M3-PRT-402 - PLACA PORTA-PLANETAS TRASEIRA" "M3P402-TEXTO" "ML")
  (M3P402:text '(248.0 35.0 0.0) 3.0 "MAT.: AISI 1020 | ESPESSURA 6" "M3P402-TEXTO" "ML")
  (M3P402:text '(318.0 35.0 0.0) 3.0 "MASSA APROX.: 0,262 kg" "M3P402-TEXTO" "ML")
  (M3P402:text '(248.0 25.0 0.0) 3.0 "ESCALA 1:1 | UNID. mm | 1o DIEDRO" "M3P402-TEXTO" "ML")
  (M3P402:text '(318.0 25.0 0.0) 3.0 "REV. R1 | FOLHA 1/1 | 2026-11-21" "M3P402-TEXTO" "ML")
  (M3P402:text '(248.0 15.0 0.0) 2.5 "STATUS: FINAL DE PROTOTIPO P0 - VALIDAR NO CAD" "M3P402-TEXTO" "ML"))
(defun M3P402:draw (/ c i a p)
  (M3P402:frame)
  (M3P402:text '(25.0 268.0 0.0) 7.0 "M3-PRT-402 - PLACA PORTA-PLANETAS TRASEIRA" "M3P402-TEXTO" "ML")
  (M3P402:text '(25.0 260.0 0.0) 3.5 "DISCO USINADO - PLACA CASADA COM M3-PRT-401 R1 - QUATRO PINOS A 90 GRAUS" "M3P402-TEXTO" "ML")
  ; frontal
  (setq c '(100.0 190.0 0.0))
  (M3P402:circle c 45.0 "M3P402-CONTORNO")
  (M3P402:circle c 30.0 "M3P402-EIXO")
  (M3P402:circle c 20.0 "M3P402-EIXO")
  (M3P402:circle c 12.5 "M3P402-CONTORNO")
  ; pin holes at 0, 90, 180 and 270 deg - approved four-planet layout
  (setq i 0)
  (repeat 4
    (setq a (* i (/ pi 2.0)) p (polar c a 30.0))
    (M3P402:circle p 5.0 "M3P402-CONTORNO") (M3P402:center p 5.0)
    (setq i (1+ i)))
  ; M5 holes at 30,150,270
  (setq i 0)
  (repeat 3
    (setq a (+ (/ pi 6.0) (* i (/ (* 2.0 pi) 3.0))) p (polar c a 20.0))
    (M3P402:circle p 2.75 "M3P402-CONTORNO") (M3P402:center p 2.75)
    (setq i (1+ i)))
  (M3P402:center c 45.0)
  (M3P402:text '(100.0 137.0 0.0) 5.0 "VISTA FRONTAL" "M3P402-TEXTO" "MC")
  (M3P402:dimH 55.0 145.0 145.0 128.0 "%%c90")
  (M3P402:text '(35.0 248.0 0.0) 3.3 "4 x %%c10 H7 EQ. 90%%d EM PCD %%c60" "M3P402-TEXTO" "ML")
  (M3P402:text '(35.0 241.0 0.0) 3.3 "3 x %%c5,5 EQ. 120%%d EM PCD %%c40" "M3P402-TEXTO" "ML")
  (M3P402:text '(35.0 234.0 0.0) 3.3 "FURO CENTRAL %%c25 H7" "M3P402-TEXTO" "ML")
  ; lateral
  (M3P402:rect 175.0 145.0 181.0 235.0 "M3P402-CONTORNO")
  (foreach y '(160.0 170.0 177.5 202.5 210.0 220.0)
    (M3P402:line (list 175.0 y 0.0) (list 181.0 y 0.0) "M3P402-OCULTA"))
  (M3P402:line '(171.0 190.0 0.0) '(185.0 190.0 0.0) "M3P402-EIXO")
  (M3P402:text '(178.0 137.0 0.0) 5.0 "VISTA LATERAL" "M3P402-TEXTO" "MC")
  (M3P402:dimH 175.0 181.0 235.0 248.0 "6 h11")
  ; complete section A-A through upper pin hole and center
  (M3P402:rect 220.0 145.0 226.0 235.0 "M3P402-CONTORNO")
  (M3P402:rect 220.0 177.5 226.0 202.5 "M3P402-CONTORNO")
  (M3P402:rect 220.0 215.0 226.0 225.0 "M3P402-CONTORNO")
  (M3P402:hatch 220.0 145.0 226.0 177.5 3.0)
  (M3P402:hatch 220.0 202.5 226.0 215.0 3.0)
  (M3P402:hatch 220.0 225.0 226.0 235.0 3.0)
  (M3P402:line '(216.0 190.0 0.0) '(230.0 190.0 0.0) "M3P402-EIXO")
  (M3P402:text '(223.0 137.0 0.0) 5.0 "CORTE A-A" "M3P402-TEXTO" "MC")
  ; Detail and interface table
  (M3P402:rect 255.0 150.0 395.0 250.0 "M3P402-TABELA")
  (M3P402:text '(325.0 243.0 0.0) 5.0 "INTERFACES E CONTROLES" "M3P402-TEXTO" "MC")
  (foreach y '(235.0 224.0 213.0 202.0 191.0 180.0 169.0 158.0)
    (M3P402:line (list 255.0 y 0.0) (list 395.0 y 0.0) "M3P402-TABELA"))
  (M3P402:line '(325.0 150.0 0.0) '(325.0 235.0 0.0) "M3P402-TABELA")
  (setq rows '((229.5 "DIAMETRO EXTERNO" "90,000") (218.5 "ESPESSURA" "6 h11")
    (207.5 "PINOS / FUROS" "4 x %%c10 g6 / H7") (196.5 "PCD PLANETAS" "%%c60 / 90%%d")
    (185.5 "CUBO / FURO" "%%c25 g6 / H7") (174.5 "FIXACAO CUBO" "3 x M5 / %%c40")
    (163.5 "POSICAO PCD60" "%%c0,05 | A | B") (154.0 "PARALELISMO FACES" "0,05")))
  (foreach r rows
    (M3P402:text (list 258.0 (car r) 0.0) 3.0 (cadr r) "M3P402-TEXTO" "ML")
    (M3P402:text (list 328.0 (car r) 0.0) 3.0 (caddr r) "M3P402-TEXTO" "ML"))
  ; notes
  (M3P402:rect 25.0 78.0 235.0 120.0 "M3P402-TABELA")
  (M3P402:text '(30.0 114.0 0.0) 4.5 "NOTAS TECNICAS" "M3P402-TEXTO" "ML")
  (M3P402:text '(30.0 106.0 0.0) 3.0 "1. EIXO DO FURO %%c25 DEFINE DATUM A; FACE INTERNA VOLTADA AOS PLANETAS DEFINE DATUM B." "M3P402-TEXTO" "ML")
  (M3P402:text '(30.0 99.0 0.0) 3.0 "2. USINAR 4 FUROS PCD60 EM CONJUNTO COM P401 R1; MARCAR ORIENTACAO." "M3P402-TEXTO" "ML")
  (M3P402:text '(30.0 92.0 0.0) 3.0 "3. CHANFROS 0,5 x 45%%d; REMOVER REBARBAS; Ra 1,6 NOS AJUSTES." "M3P402-TEXTO" "ML")
  (M3P402:text '(30.0 85.0 0.0) 3.0 "4. TOL. GERAL ISO 2768-m; NAO INVERTER A FACE B NA MONTAGEM." "M3P402-TEXTO" "ML")
  (M3P402:text '(30.0 78.5 0.0) 3.0 "5. CONFIGURACAO 4x90%%d APROVADA POR M3-AUD-001; VALIDAR NO CAD." "M3P402-TEXTO" "ML")
  (M3P402:rect 245.0 78.0 395.0 140.0 "M3P402-TABELA")
  (M3P402:text '(250.0 133.0 0.0) 4.5 "PLANO DE INSPECAO" "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 125.0 0.0) 3.0 "OD/espessura: micrometro; comparar com M3-PRT-401." "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 117.0 0.0) 3.0 "Furos H7: subito, 3 secoes e 2 direcoes." "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 109.0 0.0) 3.0 "PCDs/90%%d: maquina de medir coordenadas." "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 101.0 0.0) 3.0 "Faces: relogio em desempeno; limite 0,05." "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 93.0 0.0) 3.0 "Montagem: placa frontal, pinos, cubo e calibradores." "M3P402-TEXTO" "ML")
  (M3P402:text '(250.0 85.0 0.0) 3.0 "Aceite: par 401/402 R1 alinhado; 4 planetas livres." "M3P402-TEXTO" "ML"))

(defun C:M3_PRT_402_GERAR (/ ss)
  (M3P402:savevars) (setq *M3P402-OLDERR* *error* *error* M3P402:error)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
  (M3P402:layer "M3P402-MARGEM" 7 "Continuous" 50)
  (M3P402:layer "M3P402-CARIMBO" 7 "Continuous" 25)
  (M3P402:layer "M3P402-CONTORNO" 7 "Continuous" 50)
  (M3P402:layer "M3P402-COTA" 2 "Continuous" 25)
  (M3P402:layer "M3P402-TEXTO" 7 "Continuous" 25)
  (M3P402:layer "M3P402-EIXO" 4 "CENTER2" 25)
  (M3P402:layer "M3P402-OCULTA" 3 "HIDDEN2" 25)
  (M3P402:layer "M3P402-HACHURA" 8 "Continuous" 18)
  (M3P402:layer "M3P402-TABELA" 7 "Continuous" 25)
  (setq ss (ssget "X" '((8 . "M3P402-*")))) (if ss (command "_.ERASE" ss ""))
  (M3P402:draw) (command "_.ZOOM" "_E")
  (M3P402:restorevars) (setq *error* *M3P402-OLDERR*)
  (princ "\nM3-PRT-402 R1 gerada. Execute M3_PRT_402_AUDITAR.") (princ))
(defun C:M3_PRT_402_AUDITAR (/ ss n ok)
  (setq ss (ssget "X" '((8 . "M3P402-*"))) n (if ss (sslength ss) 0))
  (setq ok (and (> n 130) (tblsearch "LAYER" "M3P402-CONTORNO")
    (tblsearch "LAYER" "M3P402-COTA") (tblsearch "LAYER" "M3P402-HACHURA")))
  (princ "\n--- AUDITORIA M3-PRT-402 ---")
  (princ (strcat "\nEntidades M3P402: " (itoa n)))
  (princ "\nGeometria: OD90 x 6; 4x10H7 PCD60/90graus; centro25H7; 3x5.5 PCD40.")
  (princ "\nInterfaces P0: 4 pinos10g6, cubo25g6, uniao M5; par com P401 R1.")
  (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-402 carregada. Comandos: M3_PRT_402_GERAR e M3_PRT_402_AUDITAR.")
(princ)
