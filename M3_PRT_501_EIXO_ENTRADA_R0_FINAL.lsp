; Projeto M3-PLN - redutor planetario 4:1
; Uma folha A3 por arquivo / unidades mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_501_GERAR e M3_PRT_501_AUDITAR
; Arquitetura P0: comprimento 110; ponta acionamento 12h6x20; dois assentos 15k6x11 para 6202;
; assento solar 15h6x18 com rasgo 5P9x2.3; ombros 18; rosca externa M10x1.0 e furo axial M6-6H.
(vl-load-com)
(setq *M3P501-OLDERR* nil *M3P501-OLDVARS* nil)
(defun M3P501:savevars () (setq *M3P501-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS" "LTSCALE" "CELTSCALE"))))
(defun M3P501:restorevars () (if *M3P501-OLDVARS* (foreach p *M3P501-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P501-OLDVARS* nil))
(defun M3P501:error (m) (M3P501:restorevars) (if (and m (/= m "Function cancelled") (/= m "quit / exit abort")) (princ (strcat "\nM3-PRT-501 ERRO: " m))) (setq *error* *M3P501-OLDERR*) (princ))
(defun M3P501:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P501:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P501:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P501:text (p h tx l j / d) (setq d (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 tx) (cons 7 "Standard") (cons 50 0.0))) (if (= j "MC") (setq d (append d (list (cons 72 1) (cons 73 2) (cons 11 p)))) (setq d (append d (list (cons 72 0) (cons 73 2) (cons 11 p))))) (entmake d))
(defun M3P501:rect (x1 y1 x2 y2 l) (M3P501:line (list x1 y1 0.0) (list x2 y1 0.0) l) (M3P501:line (list x2 y1 0.0) (list x2 y2 0.0) l) (M3P501:line (list x2 y2 0.0) (list x1 y2 0.0) l) (M3P501:line (list x1 y2 0.0) (list x1 y1 0.0) l))
(defun M3P501:arrow (p a z l) (M3P501:line p (polar p (+ a 2.65) z) l) (M3P501:line p (polar p (- a 2.65) z) l))
(defun M3P501:dimH (x1 x2 yo yd tx / a b) (setq a (list x1 yd 0.0) b (list x2 yd 0.0)) (M3P501:line (list x1 yo 0.0) a "M3P501-COTA") (M3P501:line (list x2 yo 0.0) b "M3P501-COTA") (M3P501:line a b "M3P501-COTA") (M3P501:arrow a 0.0 2.0 "M3P501-COTA") (M3P501:arrow b pi 2.0 "M3P501-COTA") (M3P501:text (list (/ (+ x1 x2) 2.0) (+ yd 2.2) 0.0) 3.2 tx "M3P501-TEXTO" "MC"))
