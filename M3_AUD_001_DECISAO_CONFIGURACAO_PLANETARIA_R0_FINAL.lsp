; M3-AUD-001 - DECISAO DA CONFIGURACAO PLANETARIA - R0
; Folha tecnica de decisao / A3 horizontal / mm
; Comandos: M3_AUD_001_GERAR e M3_AUD_001_AUDITAR
; Resultado: adotar 4 planetas a 90 graus. Configuracao de 3 planetas a 120 graus bloqueada.
(vl-load-com)
(setq *M3D001-OLDERR* nil *M3D001-OLDVARS* nil)
(defun M3D001:savevars () (setq *M3D001-OLDVARS* (mapcar '(lambda(n)(cons n(getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3D001:restorevars () (if *M3D001-OLDVARS* (foreach p *M3D001-OLDVARS* (if(cdr p)(setvar(car p)(cdr p))))) (setq *M3D001-OLDVARS* nil))
(defun M3D001:error(m)(M3D001:restorevars)(if(and m(/= m "Function cancelled"))(princ(strcat "\nM3-AUD-001 ERRO: " m)))(setq *error* *M3D001-OLDERR*)(princ))
(defun M3D001:layer(n c lt lw)(if(not(tblsearch "LAYER" n))(entmake(list '(0 . "LAYER")'(100 . "AcDbSymbolTableRecord")'(100 . "AcDbLayerTableRecord")(cons 2 n)(cons 70 0)(cons 62 c)(cons 6 lt)(cons 370 lw)))))
(defun M3D001:line(a b l)(entmake(list '(0 . "LINE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbLine")(cons 10 a)(cons 11 b))))
(defun M3D001:circle(c r l)(entmake(list '(0 . "CIRCLE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbCircle")(cons 10 c)(cons 40 r))))
(defun M3D001:text(p h x l)(entmake(list '(0 . "TEXT")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbText")(cons 10 p)(cons 40 h)(cons 1 x)(cons 7 "Standard"))))
(defun M3D001:rect(x1 y1 x2 y2 l)(M3D001:line(list x1 y1 0)(list x2 y1 0)l)(M3D001:line(list x2 y1 0)(list x2 y2 0)l)(M3D001:line(list x2 y2 0)(list x1 y2 0)l)(M3D001:line(list x1 y2 0)(list x1 y1 0)l))
(defun M3D001:frame()
 (M3D001:rect 10 10 410 287 "M3D001-MARGEM")(M3D001:rect 20 20 400 277 "M3D001-MARGEM")
 (M3D001:rect 245 20 400 70 "M3D001-CARIMBO")(foreach y '(30 40 50 60)(M3D001:line(list 245 y 0)(list 400 y 0)"M3D001-CARIMBO"))
 (M3D001:text '(248 64 0)3.5"PROJETO: M3-PLN REDUTOR EPICICLICO 4:1""M3D001-TEXTO")
 (M3D001:text '(248 54 0)3.5"M3-AUD-001 - DECISAO CONFIGURACAO PLANETARIA""M3D001-TEXTO")
 (M3D001:text '(248 44 0)3"REV. R0 | FOLHA 1/1 | UNID. mm""M3D001-TEXTO")
 (M3D001:text '(248 34 0)3"STATUS: DECISAO DE ENGENHARIA APROVADA""M3D001-TEXTO")
 (M3D001:text '(248 24 0)3"ADOTAR 4 PLANETAS A 90 GRAUS""M3D001-APROVADO"))
(defun M3D001:draw(/ c p)
 (M3D001:frame)(M3D001:text '(25 268 0)7"M3-AUD-001 - DECISAO DA CONFIGURACAO PLANETARIA""M3D001-TEXTO")
 (M3D001:text '(25 258 0)3.5"RELACAO 4:1 PRESERVADA: ZS=20, ZP=20, ZR=60, m=1,5, alfa=20 GRAUS""M3D001-TEXTO")
 ; 3 planet option
 (setq c '(95 195 0))(M3D001:circle c 47 "M3D001-BLOQUEADO")(M3D001:circle c 16.5 "M3D001-BLOQUEADO")
 (foreach a (list(/ pi 2)(+(/ pi 2)(/(* 2 pi)3))(+(/ pi 2)(/(* 4 pi)3))) (setq p(polar c a 30))(M3D001:circle p 16.5 "M3D001-BLOQUEADO"))
 (M3D001:text '(48 138 0)5"OPCAO A - 3 PLANETAS / 120 GRAUS""M3D001-BLOQUEADO")
 (M3D001:text '(41 247 0)3.2"(ZR+ZS)/NP = 80/3 = 26,667""M3D001-BLOQUEADO")
 (M3D001:text '(41 239 0)3.2"RESULTADO NAO INTEIRO""M3D001-BLOQUEADO")
 (M3D001:text '(41 231 0)3.2"RISCO DE FASE SIMULTANEA""M3D001-BLOQUEADO")
 (M3D001:text '(41 223 0)3.2"STATUS: BLOQUEADA PARA FABRICACAO""M3D001-BLOQUEADO")
 ; 4 planet option
