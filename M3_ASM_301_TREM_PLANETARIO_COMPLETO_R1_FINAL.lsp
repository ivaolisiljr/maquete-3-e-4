(defun C:M3_ASM_301_GERAR(/ ss)
 (M3A301:savevars)(setq *M3A301-OLDERR* *error* *error* M3A301:error)(setvar "CMDECHO" 0)(setvar "OSMODE" 0)(setvar "ORTHOMODE" 0)(setvar "INSUNITS" 4)
 (M3A301:layer "M3A301-MARGEM" 7 "Continuous" 50)(M3A301:layer "M3A301-CARIMBO" 7 "Continuous" 25)(M3A301:layer "M3A301-CARCACA" 8 "Continuous" 25)
 (M3A301:layer "M3A301-COROA" 2 "Continuous" 50)(M3A301:layer "M3A301-SOLAR" 1 "Continuous" 50)(M3A301:layer "M3A301-PLANETA" 3 "Continuous" 50)(M3A301:layer "M3A301-PORTA" 5 "Continuous" 50)
 (M3A301:layer "M3A301-TEXTO" 7 "Continuous" 25)(M3A301:layer "M3A301-EIXO" 4 "CENTER2" 25)(M3A301:layer "M3A301-TABELA" 7 "Continuous" 25)
 (setq ss(ssget "X" '((8 . "M3A301-*"))))(if ss(command "_.ERASE" ss ""))(M3A301:draw)(command "_.ZOOM" "_E")(M3A301:restorevars)(setq *error* *M3A301-OLDERR*)
 (princ "\nM3-ASM-301 R1 gerada. Execute M3_ASM_301_AUDITAR.")(princ))
(defun C:M3_ASM_301_AUDITAR(/ ss n ok)
 (setq ss(ssget "X" '((8 . "M3A301-*"))) n(if ss(sslength ss)0))(setq ok(and(> n 80)(tblsearch "LAYER" "M3A301-SOLAR")(tblsearch "LAYER" "M3A301-PLANETA")))
 (princ "\n--- AUDITORIA M3-ASM-301 ---")(princ(strcat "\nEntidades: "(itoa n)))(princ "\nTrem: zS20, 4xzP20, zR60, m1.5, i4:1.")
 (if ok(princ "\nRESULTADO ESTATICO: APROVADO; FASE INTEIRA 80/4=20.")(princ "\nRESULTADO: REPROVADO."))(princ))
(princ "\nM3-ASM-301 carregada. Comandos: M3_ASM_301_GERAR e M3_ASM_301_AUDITAR.")(princ)
