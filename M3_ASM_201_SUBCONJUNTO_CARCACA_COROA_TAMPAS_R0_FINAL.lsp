; A3 horizontal / mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_ASM_201_GERAR e M3_ASM_201_AUDITAR
; Componentes: P201 carcaca, P202/P203 tampas, P305 coroa, 2x6202-2RS, fixadores M6.
(vl-load-com)
(setq *M3A201-OLDERR* nil *M3A201-OLDVARS* nil)
(defun M3A201:savevars () (setq *M3A201-OLDVARS* (mapcar '(lambda(n)(cons n(getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3A201:restorevars () (if *M3A201-OLDVARS* (foreach p *M3A201-OLDVARS* (if(cdr p)(setvar(car p)(cdr p))))) (setq *M3A201-OLDVARS* nil))
(defun M3A201:error(m)(M3A201:restorevars)(if(and m(/= m "Function cancelled"))(princ(strcat "\nM3-ASM-201 ERRO: " m)))(setq *error* *M3A201-OLDERR*)(princ))
(defun M3A201:layer(n c lt lw)(if(not(tblsearch "LAYER" n))(entmake(list '(0 . "LAYER")'(100 . "AcDbSymbolTableRecord")'(100 . "AcDbLayerTableRecord")(cons 2 n)(cons 70 0)(cons 62 c)(cons 6 lt)(cons 370 lw)))))
(defun M3A201:line(a b l)(entmake(list '(0 . "LINE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbLine")(cons 10 a)(cons 11 b))))
(defun M3A201:circle(c r l)(entmake(list '(0 . "CIRCLE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbCircle")(cons 10 c)(cons 40 r))))
(defun M3A201:text(p h x l)(entmake(list '(0 . "TEXT")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbText")(cons 10 p)(cons 40 h)(cons 1 x)(cons 7 "Standard"))))
(defun M3A201:rect(x1 y1 x2 y2 l)(M3A201:line(list x1 y1 0)(list x2 y1 0)l)(M3A201:line(list x2 y1 0)(list x2 y2 0)l)(M3A201:line(list x2 y2 0)(list x1 y2 0)l)(M3A201:line(list x1 y2 0)(list x1 y1 0)l))
(defun M3A201:hatch(x1 y1 x2 y2 / x)(setq x x1)(while(< x x2)(M3A201:line(list x y1 0)(list(min x2(+ x(- y2 y1))) y2 0)"M3A201-HACHURA")(setq x(+ x 3))))
