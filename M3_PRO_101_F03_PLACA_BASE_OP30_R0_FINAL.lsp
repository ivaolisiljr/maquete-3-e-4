(defun C:M3_PRO_101_F03_GERAR (/ ss)
 (M3P101F03:sv) (setq *M3P101F03-ERR* *error* *error* M3P101F03:er)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (foreach a '(("M3P101F03-BORDA" 7 "Continuous" 50)("M3P101F03-TABELA" 7 "Continuous" 25)("M3P101F03-TEXTO" 7 "Continuous" 25)("M3P101F03-CODIGO" 1 "Continuous" 35)("M3P101F03-PECA" 7 "Continuous" 50)("M3P101F03-FIXACAO" 6 "Continuous" 50)("M3P101F03-MESA" 8 "Continuous" 50)("M3P101F03-DATUM" 2 "Continuous" 35)("M3P101F03-FERRAMENTA" 1 "Continuous" 50)("M3P101F03-AVANCO" 4 "Continuous" 35)("M3P101F03-COTA" 2 "Continuous" 25)("M3P101F03-MAPA" 3 "Continuous" 25)) (M3P101F03:lay (car a) (cadr a) (caddr a) (cadddr a)))
 (setq ss (ssget "X" '((8 . "M3P101F03-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P101F03:draw) (command "_.ZOOM" "_E") (M3P101F03:rv) (setq *error* *M3P101F03-ERR*)
 (princ "\nM3-PRO-101-F03 gerada. Execute M3_PRO_101_F03_AUDITAR.") (princ))
(defun C:M3_PRO_101_F03_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P101F03-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 125) (tblsearch "LAYER" "M3P101F03-DATUM") (tblsearch "LAYER" "M3P101F03-MAPA") (tblsearch "LAYER" "M3P101F03-COTA")))
 (princ "\n--- AUDITORIA M3-PRO-101-F03 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nOperacao 30: datum A apoiado; espessura 10 +/-0.15; 9 pontos; paralelismo 0.15.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRO-101-F03 carregada. Comandos: M3_PRO_101_F03_GERAR e M3_PRO_101_F03_AUDITAR.") (princ)
