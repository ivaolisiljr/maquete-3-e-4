(defun C:M3_ASM_201_GERAR(/ ss)
 (M3A201:savevars)(setq *M3A201-OLDERR* *error* *error* M3A201:error)(setvar "CMDECHO" 0)(setvar "OSMODE" 0)(setvar "ORTHOMODE" 0)(setvar "INSUNITS" 4)
 (M3A201:layer "M3A201-MARGEM" 7 "Continuous" 50)(M3A201:layer "M3A201-CARIMBO" 7 "Continuous" 25)(M3A201:layer "M3A201-CONTORNO" 7 "Continuous" 50)(M3A201:layer "M3A201-COROA" 2 "Continuous" 50)
 (M3A201:layer "M3A201-TEXTO" 7 "Continuous" 25)(M3A201:layer "M3A201-EIXO" 4 "CENTER2" 25)(M3A201:layer "M3A201-HACHURA" 8 "Continuous" 18)(M3A201:layer "M3A201-TABELA" 7 "Continuous" 25)
 (setq ss(ssget "X" '((8 . "M3A201-*"))))(if ss(command "_.ERASE" ss ""))(M3A201:draw)(command "_.ZOOM" "_E")(M3A201:restorevars)(setq *error* *M3A201-OLDERR*)
 (princ "\nM3-ASM-201 R0 gerada. Execute M3_ASM_201_AUDITAR.")(princ))
(defun C:M3_ASM_201_AUDITAR(/ ss n ok)
 (setq ss(ssget "X" '((8 . "M3A201-*"))) n(if ss(sslength ss)0))(setq ok(and(> n 85)(tblsearch "LAYER" "M3A201-COROA")))
 (princ "\n--- AUDITORIA M3-ASM-201 ---")(princ(strcat "\nEntidades: "(itoa n)))(princ "\nBOM: carcaca, coroa, 2 tampas, 2 rolamentos, fixadores.")
 (if ok(princ "\nRESULTADO ESTATICO: APROVADO.")(princ "\nRESULTADO: REPROVADO."))(princ))
(princ "\nM3-ASM-201 carregada. Comandos: M3_ASM_201_GERAR e M3_ASM_201_AUDITAR.")(princ)
