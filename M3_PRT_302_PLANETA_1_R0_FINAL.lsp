; M3-PRT-302 - ENGRENAGEM PLANETARIA 1 - R0
; Projeto: M3-PLN Redutor planetario epiciclico 4:1
; Status: PARA PROTOTIPO P0 - validar montagem e engrenamento no CAD
; AutoCAD Mechanical 2025 PT-BR / AutoLISP padrao
; Geracao 2D em Model Space, folha A3 horizontal, unidades em mm
; Comandos: M3_PRT_302_GERAR e M3_PRT_302_AUDITAR
; Revisao estatica: R1 geometria, R2 desenho, R3 codigo

(vl-load-com)

(setq *M3P302-OLDERR* nil)
(setq *M3P302-OLDVARS* nil)

(defun M3P302:savevars (/ names)
  (setq names '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "LTSCALE" "CELTSCALE" "INSUNITS"))
  (setq *M3P302-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) names))
)

(defun M3P302:restorevars ()
  (if *M3P302-OLDVARS*
    (foreach p *M3P302-OLDVARS*
      (if (and (car p) (cdr p)) (setvar (car p) (cdr p)))
    )
  )
  (setq *M3P302-OLDVARS* nil)
)

(defun M3P302:error (msg)
  (M3P302:restorevars)
  (if (and msg (/= msg "Function cancelled") (/= msg "quit / exit abort"))
    (princ (strcat "\nM3-PRT-302 ERRO: " msg))
  )
  (setq *error* *M3P302-OLDERR*)
  (princ)
)

(defun M3P302:layer (name color ltype lw)
  (if (not (tblsearch "LAYER" name))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
                   (cons 2 name) (cons 70 0) (cons 62 color) (cons 6 ltype) (cons 370 lw)))
  )
)

(defun M3P302:line (p1 p2 lay)
  (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 lay)
                 '(100 . "AcDbLine") (cons 10 p1) (cons 11 p2)))
)

(defun M3P302:circle (c r lay)
  (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 lay)
                 '(100 . "AcDbCircle") (cons 10 c) (cons 40 r)))
)

(defun M3P302:arc (c r a1 a2 lay)
  (entmake (list '(0 . "ARC") '(100 . "AcDbEntity") (cons 8 lay)
                 '(100 . "AcDbCircle") (cons 10 c) (cons 40 r)
                 '(100 . "AcDbArc") (cons 50 a1) (cons 51 a2)))
)

(defun M3P302:text (p h s lay just / data)
  (setq data (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 lay)
                   '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 s)
                   (cons 7 "Standard") (cons 50 0.0)))
  (cond
    ((= just "MC") (setq data (append data (list (cons 72 1) (cons 73 2) (cons 11 p)))))
    ((= just "MR") (setq data (append data (list (cons 72 2) (cons 73 2) (cons 11 p)))))
    ((= just "ML") (setq data (append data (list (cons 72 0) (cons 73 2) (cons 11 p)))))
  )
  (entmake data)
)

(defun M3P302:rect (x1 y1 x2 y2 lay)
  (M3P302:line (list x1 y1 0.0) (list x2 y1 0.0) lay)
  (M3P302:line (list x2 y1 0.0) (list x2 y2 0.0) lay)
  (M3P302:line (list x2 y2 0.0) (list x1 y2 0.0) lay)
  (M3P302:line (list x1 y2 0.0) (list x1 y1 0.0) lay)
)

(defun M3P302:arrow (tip ang size lay / p1 p2)
  (setq p1 (polar tip (+ ang 2.65) size))
  (setq p2 (polar tip (- ang 2.65) size))
  (M3P302:line tip p1 lay)
  (M3P302:line tip p2 lay)
)

(defun M3P302:dimH (x1 x2 yobj ydim txt / p1 p2)
  (setq p1 (list x1 ydim 0.0) p2 (list x2 ydim 0.0))
  (M3P302:line (list x1 yobj 0.0) p1 "M3P302-COTA")
  (M3P302:line (list x2 yobj 0.0) p2 "M3P302-COTA")
  (M3P302:line p1 p2 "M3P302-COTA")
  (M3P302:arrow p1 0.0 2.0 "M3P302-COTA")
  (M3P302:arrow p2 pi 2.0 "M3P302-COTA")
  (M3P302:text (list (/ (+ x1 x2) 2.0) (+ ydim 2.2) 0.0) 3.5 txt "M3P302-TEXTO" "MC")
)

(defun M3P302:dimV (y1 y2 xobj xdim txt / p1 p2)
  (setq p1 (list xdim y1 0.0) p2 (list xdim y2 0.0))
  (M3P302:line (list xobj y1 0.0) p1 "M3P302-COTA")
  (M3P302:line (list xobj y2 0.0) p2 "M3P302-COTA")
  (M3P302:line p1 p2 "M3P302-COTA")
  (M3P302:arrow p1 (/ pi 2.0) 2.0 "M3P302-COTA")
  (M3P302:arrow p2 (* 1.5 pi) 2.0 "M3P302-COTA")
  (M3P302:text (list (+ xdim 3.0) (/ (+ y1 y2) 2.0) 0.0) 3.5 txt "M3P302-TEXTO" "ML")
)

(defun M3P302:center (c r)
  (M3P302:line (polar c pi (+ r 4.0)) (polar c 0.0 (+ r 4.0)) "M3P302-EIXO")
  (M3P302:line (polar c (* 1.5 pi) (+ r 4.0)) (polar c (/ pi 2.0) (+ r 4.0)) "M3P302-EIXO")
)

(defun M3P302:hatchRect (x1 y1 x2 y2 spacing / x)
  (setq x (- x1 (- y2 y1)))
  (while (< x x2)
    (cond
      ((< x x1) (M3P302:line (list x1 (+ y1 (- x1 x)) 0.0) (list (min x2 (+ x (- y2 y1))) y2 0.0) "M3P302-HACHURA"))
      (T (M3P302:line (list x y1 0.0) (list (min x2 (+ x (- y2 y1))) (min y2 (+ y1 (- x2 x))) 0.0) "M3P302-HACHURA"))
    )
    (setq x (+ x spacing))
  )
)

(defun M3P302:gearFront (c / ro rp rr rb rk a p1 p2)
  (setq ro 16.5 rp 15.0 rr 13.125 rb 14.0954 rk 5.0)
  (M3P302:circle c ro "M3P302-CONTORNO")
  (M3P302:circle c rp "M3P302-EIXO")
  (M3P302:circle c rr "M3P302-OCULTA")
  (M3P302:circle c rb "M3P302-AUX")
  (M3P302:circle c rk "M3P302-CONTORNO")
  ; planeta com furo liso para giro sobre pino planetario
  (M3P302:center c ro)
)

