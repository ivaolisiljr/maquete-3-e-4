; M3-ASM-301 - TREM PLANETARIO COMPLETO - R1 FINAL DE PROTOTIPO
; A3 horizontal / mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_ASM_301_GERAR e M3_ASM_301_AUDITAR
; Configuracao: coroa fixa z60, solar entrada z20, 4 planetas z20, porta-planetas saida.
; m1.5, alfa20, centros planetarios R30, relacao ideal 4:1.
(vl-load-com)
(setq *M3A301-OLDERR* nil *M3A301-OLDVARS* nil)
(defun M3A301:savevars () (setq *M3A301-OLDVARS* (mapcar '(lambda(n)(cons n(getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3A301:restorevars () (if *M3A301-OLDVARS* (foreach p *M3A301-OLDVARS* (if(cdr p)(setvar(car p)(cdr p))))) (setq *M3A301-OLDVARS* nil))
(defun M3A301:error(m)(M3A301:restorevars)(if(and m(/= m "Function cancelled"))(princ(strcat "\nM3-ASM-301 ERRO: " m)))(setq *error* *M3A301-OLDERR*)(princ))
(defun M3A301:layer(n c lt lw)(if(not(tblsearch "LAYER" n))(entmake(list '(0 . "LAYER")'(100 . "AcDbSymbolTableRecord")'(100 . "AcDbLayerTableRecord")(cons 2 n)(cons 70 0)(cons 62 c)(cons 6 lt)(cons 370 lw)))))
(defun M3A301:line(a b l)(entmake(list '(0 . "LINE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbLine")(cons 10 a)(cons 11 b))))
(defun M3A301:circle(c r l)(entmake(list '(0 . "CIRCLE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbCircle")(cons 10 c)(cons 40 r))))
(defun M3A301:text(p h x l)(entmake(list '(0 . "TEXT")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbText")(cons 10 p)(cons 40 h)(cons 1 x)(cons 7 "Standard"))))
(defun M3A301:rect(x1 y1 x2 y2 l)(M3A301:line(list x1 y1 0)(list x2 y1 0)l)(M3A301:line(list x2 y1 0)(list x2 y2 0)l)(M3A301:line(list x2 y2 0)(list x1 y2 0)l)(M3A301:line(list x1 y2 0)(list x1 y1 0)l))
