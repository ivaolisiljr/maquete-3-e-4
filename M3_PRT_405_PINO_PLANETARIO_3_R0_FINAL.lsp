  (M3P405:text '(25.0 268.0 0.0) 7.0 "M3-PRT-405 - PINO PLANETARIO 3" "M3P405-TEXTO" "ML")
  (M3P405:text '(25.0 260.0 0.0) 3.5 "PINO 3 DO LOTE CASADO P403/P404/P405 - RETENCAO AXIAL POR PARAFUSOS M5" "M3P405-TEXTO" "ML")
  ; vista principal longitudinal, escala grafica 4:1: comprimento 128 e diametro 40
  (setq x1 45.0 x2 173.0 yc 205.0 r 20.0)
  (M3P405:line (list (+ x1 2.0) (- yc r) 0.0) (list (- x2 2.0) (- yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list (+ x1 2.0) (+ yc r) 0.0) (list (- x2 2.0) (+ yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x1 (- yc (- r 2.0)) 0.0) (list x1 (+ yc (- r 2.0)) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x1 (- yc (- r 2.0)) 0.0) (list (+ x1 2.0) (- yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x1 (+ yc (- r 2.0)) 0.0) (list (+ x1 2.0) (+ yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x2 (- yc (- r 2.0)) 0.0) (list x2 (+ yc (- r 2.0)) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x2 (- yc (- r 2.0)) 0.0) (list (- x2 2.0) (- yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list x2 (+ yc (- r 2.0)) 0.0) (list (- x2 2.0) (+ yc r) 0.0) "M3P405-CONTORNO")
  (M3P405:line (list (- x1 8.0) yc 0.0) (list (+ x2 8.0) yc 0.0) "M3P405-EIXO")
  ; hidden thread drill limits at 7 mm each end, scaled 4x = 28
