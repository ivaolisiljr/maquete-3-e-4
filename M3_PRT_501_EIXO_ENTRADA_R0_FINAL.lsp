(defun C:M3_PRT_501_GERAR (/ ss)
 (M3P501:savevars) (setq *M3P501-OLDERR* *error* *error* M3P501:error)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P501:layer "M3P501-MARGEM" 7 "Continuous" 50) (M3P501:layer "M3P501-CARIMBO" 7 "Continuous" 25)
 (M3P501:layer "M3P501-CONTORNO" 7 "Continuous" 50) (M3P501:layer "M3P501-COTA" 2 "Continuous" 25)
 (M3P501:layer "M3P501-TEXTO" 7 "Continuous" 25) (M3P501:layer "M3P501-EIXO" 4 "CENTER2" 25)
 (M3P501:layer "M3P501-OCULTA" 3 "HIDDEN2" 25) (M3P501:layer "M3P501-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P501-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P501:draw) (command "_.ZOOM" "_E") (M3P501:restorevars) (setq *error* *M3P501-OLDERR*)
 (princ "\nM3-PRT-501 R0 gerada. Execute M3_PRT_501_AUDITAR.") (princ))
(defun C:M3_PRT_501_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P501-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 130) (tblsearch "LAYER" "M3P501-CONTORNO") (tblsearch "LAYER" "M3P501-COTA") (tblsearch "LAYER" "M3P501-EIXO")))
 (princ "\n--- AUDITORIA M3-PRT-501 ---") (princ (strcat "\nEntidades M3P501: " (itoa n)))
 (princ "\nArquitetura: L110; 2x15k6x11; solar15h6x18; entrada12h6x20.")
 (princ "\nElementos: rolamentos 6202-2RS; chavetas 4x4 e 5x5; M10 externo e M6 interno.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-501 carregada. Comandos: M3_PRT_501_GERAR e M3_PRT_501_AUDITAR.")
(princ)
