; M3-PRT-305 - COROA INTERNA - R0 FINAL DE PROTOTIPO
; Projeto M3-PLN - redutor planetario 4:1
; Folha A3 horizontal em Model Space, unidades mm
; Comandos: M3_PRT_305_GERAR e M3_PRT_305_AUDITAR
; Geometria: interna reta, m1.5, z60, alfa20, d90, da87, df93.75, b15
; Decisao P0 desenvolvida: OD124 h7, 6 furos 4.5 em PCD112 para fixacao axial M4
(vl-load-com)
(setq *M3P305-OLDERR* nil *M3P305-OLDVARS* nil)

(defun M3P305:savevars ()
  (setq *M3P305-OLDVARS*
    (mapcar '(lambda (n) (cons n (getvar n)))
      '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "LTSCALE" "CELTSCALE" "INSUNITS"))))
(defun M3P305:restorevars ()
  (if *M3P305-OLDVARS*
    (foreach p *M3P305-OLDVARS* (if (cdr p) (setvar (car p) (cdr p)))))
  (setq *M3P305-OLDVARS* nil))
(defun M3P305:error (msg)
  (M3P305:restorevars)
  (if (and msg (/= msg "Function cancelled") (/= msg "quit / exit abort"))
    (princ (strcat "\nM3-PRT-305 ERRO: " msg)))
  (setq *error* *M3P305-OLDERR*) (princ))
(defun M3P305:layer (n c lt lw)
  (if (not (tblsearch "LAYER" n))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
      '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c)
      (cons 6 lt) (cons 370 lw)))))
(defun M3P305:line (a b l)
  (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P305:circle (c r l)
  (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P305:text (p h txt l j / d)
  (setq d (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l)
    '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 txt)
    (cons 7 "Standard") (cons 50 0.0)))
  (cond ((= j "MC") (setq d (append d (list (cons 72 1) (cons 73 2) (cons 11 p)))))
        ((= j "ML") (setq d (append d (list (cons 72 0) (cons 73 2) (cons 11 p))))))
  (entmake d))
(defun M3P305:rect (x1 y1 x2 y2 l)
  (M3P305:line (list x1 y1 0.0) (list x2 y1 0.0) l)
  (M3P305:line (list x2 y1 0.0) (list x2 y2 0.0) l)
  (M3P305:line (list x2 y2 0.0) (list x1 y2 0.0) l)
  (M3P305:line (list x1 y2 0.0) (list x1 y1 0.0) l))
(defun M3P305:center (c r)
  (M3P305:line (polar c pi (+ r 4.0)) (polar c 0.0 (+ r 4.0)) "M3P305-EIXO")
  (M3P305:line (polar c (* 1.5 pi) (+ r 4.0)) (polar c (/ pi 2.0) (+ r 4.0)) "M3P305-EIXO"))
(defun M3P305:arrow (p a s l)
  (M3P305:line p (polar p (+ a 2.65) s) l)
  (M3P305:line p (polar p (- a 2.65) s) l))
(defun M3P305:dimH (x1 x2 yo yd tx / a b)
  (setq a (list x1 yd 0.0) b (list x2 yd 0.0))
  (M3P305:line (list x1 yo 0.0) a "M3P305-COTA")
  (M3P305:line (list x2 yo 0.0) b "M3P305-COTA")
  (M3P305:line a b "M3P305-COTA")
  (M3P305:arrow a 0.0 2.0 "M3P305-COTA")
  (M3P305:arrow b pi 2.0 "M3P305-COTA")
  (M3P305:text (list (/ (+ x1 x2) 2.0) (+ yd 2.5) 0.0) 3.5 tx "M3P305-TEXTO" "MC"))
(defun M3P305:dimV (y1 y2 xo xd tx / a b)
  (setq a (list xd y1 0.0) b (list xd y2 0.0))
  (M3P305:line (list xo y1 0.0) a "M3P305-COTA")
  (M3P305:line (list xo y2 0.0) b "M3P305-COTA")
  (M3P305:line a b "M3P305-COTA")
  (M3P305:arrow a (/ pi 2.0) 2.0 "M3P305-COTA")
  (M3P305:arrow b (* 1.5 pi) 2.0 "M3P305-COTA")
  (M3P305:text (list (+ xd 3.0) (/ (+ y1 y2) 2.0) 0.0) 3.5 tx "M3P305-TEXTO" "ML"))
(defun M3P305:hatchBand (x1 y1 x2 y2 step / x)
  (setq x (- x1 (- y2 y1)))
  (while (< x x2)
    (M3P305:line
      (list (max x1 x) (+ y1 (max 0.0 (- x1 x))) 0.0)
      (list (min x2 (+ x (- y2 y1))) (min y2 (+ y1 (- x2 x))) 0.0)
      "M3P305-HACHURA")
    (setq x (+ x step))))
(defun M3P305:frame ()
  (M3P305:rect 10.0 10.0 410.0 287.0 "M3P305-MARGEM")
  (M3P305:rect 20.0 20.0 400.0 277.0 "M3P305-MARGEM")
  (M3P305:rect 245.0 20.0 400.0 70.0 "M3P305-CARIMBO")
  (foreach y '(30.0 40.0 50.0 60.0) (M3P305:line (list 245.0 y 0.0) (list 400.0 y 0.0) "M3P305-CARIMBO"))
  (M3P305:line '(315.0 20.0 0.0) '(315.0 60.0 0.0) "M3P305-CARIMBO")
  (M3P305:text '(248.0 65.0 0.0) 3.5 "CENTRO PAULA SOUZA / ETEC" "M3P305-TEXTO" "ML")
  (M3P305:text '(248.0 55.0 0.0) 3.5 "PROJETO: M3-PLN REDUTOR EPICICLICO 4:1" "M3P305-TEXTO" "ML")
  (M3P305:text '(248.0 45.0 0.0) 3.5 "M3-PRT-305 - COROA INTERNA" "M3P305-TEXTO" "ML")
  (M3P305:text '(248.0 35.0 0.0) 3.0 "MAT.: AISI 1045 NORMALIZADO" "M3P305-TEXTO" "ML")
  (M3P305:text '(318.0 35.0 0.0) 3.0 "MASSA: DETERMINAR NO CAD" "M3P305-TEXTO" "ML")
  (M3P305:text '(248.0 25.0 0.0) 3.0 "ESCALA 1:1 | UNID. mm | 1o DIEDRO" "M3P305-TEXTO" "ML")
  (M3P305:text '(318.0 25.0 0.0) 3.0 "REV. R0 | FOLHA 1/1 | 2026-11-20" "M3P305-TEXTO" "ML")
  (M3P305:text '(248.0 15.0 0.0) 2.5 "STATUS: FINAL DE PROTOTIPO P0 - VALIDAR NO CAD" "M3P305-TEXTO" "ML"))
(defun M3P305:draw (/ c i a p xl xr yb yt rows)
  (M3P305:frame)
  (M3P305:text '(25.0 268.0 0.0) 7.0 "M3-PRT-305 - COROA INTERNA" "M3P305-TEXTO" "ML")
  (M3P305:text '(25.0 260.0 0.0) 3.5 "REPRESENTACAO SIMPLIFICADA - DADOS DA DENTADURA CONTROLAM A FABRICACAO" "M3P305-TEXTO" "ML")
  ; vista frontal: OD, pe, primitivo, cabeca e seis furos
  (setq c '(92.0 188.0 0.0))
  (M3P305:circle c 62.0 "M3P305-CONTORNO")
  (M3P305:circle c 46.875 "M3P305-CONTORNO")
  (M3P305:circle c 45.0 "M3P305-EIXO")
  (M3P305:circle c 43.5 "M3P305-CONTORNO")
  (M3P305:circle c 56.0 "M3P305-EIXO")
  (setq i 0)
  (repeat 6
    (setq a (* i (/ pi 3.0)) p (polar c a 56.0))
    (M3P305:circle p 2.25 "M3P305-CONTORNO")
    (M3P305:line (polar p pi 3.3) (polar p 0.0 3.3) "M3P305-EIXO")
    (M3P305:line (polar p (* 1.5 pi) 3.3) (polar p (/ pi 2.0) 3.3) "M3P305-EIXO")
    (setq i (1+ i)))
  (M3P305:center c 62.0)
  (M3P305:text '(92.0 117.0 0.0) 5.0 "VISTA FRONTAL" "M3P305-TEXTO" "MC")
  (M3P305:dimH 30.0 154.0 126.0 108.0 "%%c124 h7")
  (M3P305:text '(32.0 246.0 0.0) 3.5 "6 x %%c4,5 EQ. EM PCD %%c112" "M3P305-TEXTO" "ML")
  (M3P305:line '(72.0 242.0 0.0) '(120.0 236.5 0.0) "M3P305-COTA")
  (M3P305:arrow '(120.0 236.5 0.0) -0.2 2.0 "M3P305-COTA")
  ; lateral
  (setq xl 178.0 xr 193.0 yb 126.0 yt 250.0)
  (M3P305:rect xl yb xr yt "M3P305-CONTORNO")
  (M3P305:line (list xl 141.125 0.0) (list xr 141.125 0.0) "M3P305-OCULTA")
  (M3P305:line (list xl 234.875 0.0) (list xr 234.875 0.0) "M3P305-OCULTA")
  (M3P305:line (list (- xl 4.0) 188.0 0.0) (list (+ xr 4.0) 188.0 0.0) "M3P305-EIXO")
  (M3P305:text '(185.5 117.0 0.0) 5.0 "VISTA LATERAL" "M3P305-TEXTO" "MC")
  (M3P305:dimH xl xr yt 258.0 "15 h11")
  ; corte A-A, anel cortado em dois setores
  (setq xl 218.0 xr 233.0 yb 126.0 yt 250.0)
  (M3P305:rect xl yb xr yt "M3P305-CONTORNO")
  (M3P305:rect xl 141.125 xr 234.875 "M3P305-CONTORNO")
  (M3P305:hatchBand xl yb xr 141.125 3.0)
  (M3P305:hatchBand xl 234.875 xr yt 3.0)
  (M3P305:line (list (- xl 4.0) 188.0 0.0) (list (+ xr 4.0) 188.0 0.0) "M3P305-EIXO")
  (M3P305:text '(225.5 117.0 0.0) 5.0 "CORTE A-A" "M3P305-TEXTO" "MC")
  (M3P305:text '(205.0 263.0 0.0) 3.2 "0,5 x 45%%d NAS ARESTAS EXTERNAS" "M3P305-TEXTO" "ML")
  ; quadro dentadura
  (M3P305:rect 260.0 150.0 395.0 252.0 "M3P305-TABELA")
  (M3P305:text '(327.5 245.0 0.0) 5.0 "DADOS DA DENTADURA INTERNA" "M3P305-TEXTO" "MC")
  (foreach y '(237.0 228.0 219.0 210.0 201.0 192.0 183.0 174.0 165.0 156.0)
    (M3P305:line (list 260.0 y 0.0) (list 395.0 y 0.0) "M3P305-TABELA"))
  (M3P305:line '(330.0 150.0 0.0) '(330.0 237.0 0.0) "M3P305-TABELA")
  (setq rows '((232.5 "TIPO" "INTERNA RETA") (223.5 "MODULO m" "1,5")
    (214.5 "DENTES z" "60") (205.5 "ANGULO PRESSAO" "20%%d")
    (196.5 "DIAM. PRIMITIVO d" "90,000") (187.5 "DIAM. CABECA da" "87,000")
    (178.5 "DIAM. PE df" "93,750") (169.5 "DIAM. BASE db" "84,572")
    (160.5 "LARGURA b" "15 h11") (152.5 "BACKLASH MONT." "0,10 a 0,20")))
  (foreach r rows
    (M3P305:text (list 263.0 (car r) 0.0) 3.0 (cadr r) "M3P305-TEXTO" "ML")
    (M3P305:text (list 333.0 (car r) 0.0) 3.0 (caddr r) "M3P305-TEXTO" "ML"))
  ; notas e inspecao
  (M3P305:rect 25.0 78.0 235.0 104.0 "M3P305-TABELA")
  (M3P305:text '(30.0 98.0 0.0) 4.0 "NOTAS TECNICAS" "M3P305-TEXTO" "ML")
  (M3P305:text '(30.0 91.0 0.0) 2.8 "1. OD %%c124 h7 DEFINE DATUM A; FACE DE APOIO DEFINE DATUM B." "M3P305-TEXTO" "ML")
  (M3P305:text '(30.0 85.0 0.0) 2.8 "2. BATIMENTO DA DENTADURA EM A: 0,08 MAX; PERPENDICULARIDADE FACE/A: 0,05." "M3P305-TEXTO" "ML")
  (M3P305:text '(30.0 79.0 0.0) 2.8 "3. TOL. GERAL ISO 2768-m; REMOVER REBARBAS; VALIDAR FIXACAO M4 NO CAD." "M3P305-TEXTO" "ML")
  (M3P305:rect 25.0 106.0 235.0 116.0 "M3P305-TABELA")
  (M3P305:text '(30.0 111.0 0.0) 2.8 "P0 DESENVOLVIDO: 6 FUROS %%c4,5 / PCD112 E OD124 h7 PARA CARCACA %%c124." "M3P305-TEXTO" "ML")
  (M3P305:rect 245.0 78.0 395.0 140.0 "M3P305-TABELA")
  (M3P305:text '(250.0 133.0 0.0) 5.0 "PLANO DE INSPECAO" "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 125.0 0.0) 3.1 "OD 124 h7: micrometro, 3 secoes/2 direcoes." "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 117.0 0.0) 3.1 "Dentado: medicao sobre pinos + contato azul." "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 109.0 0.0) 3.1 "Batimento: relogio sobre mandril/anel mestre." "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 101.0 0.0) 3.1 "6 furos: calibre e maquina de medir coordenadas." "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 93.0 0.0) 3.1 "Montagem: contato nos 3 planetas e giro 360%%d." "M3P305-TEXTO" "ML")
  (M3P305:text '(250.0 85.0 0.0) 3.1 "Aceite P0: backlash 0,10-0,20; sem travamento." "M3P305-TEXTO" "ML"))

(defun C:M3_PRT_305_GERAR (/ ss)
  (M3P305:savevars) (setq *M3P305-OLDERR* *error* *error* M3P305:error)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
  (M3P305:layer "M3P305-MARGEM" 7 "Continuous" 50)
  (M3P305:layer "M3P305-CARIMBO" 7 "Continuous" 25)
  (M3P305:layer "M3P305-CONTORNO" 7 "Continuous" 50)
  (M3P305:layer "M3P305-COTA" 2 "Continuous" 25)
  (M3P305:layer "M3P305-TEXTO" 7 "Continuous" 25)
  (M3P305:layer "M3P305-EIXO" 4 "CENTER2" 25)
  (M3P305:layer "M3P305-OCULTA" 3 "HIDDEN2" 25)
  (M3P305:layer "M3P305-HACHURA" 8 "Continuous" 18)
  (M3P305:layer "M3P305-TABELA" 7 "Continuous" 25)
  (setq ss (ssget "X" '((8 . "M3P305-*"))))
  (if ss (command "_.ERASE" ss ""))
  (M3P305:draw) (command "_.ZOOM" "_E")
  (M3P305:restorevars) (setq *error* *M3P305-OLDERR*)
  (princ "\nM3-PRT-305 R0 gerada. Execute M3_PRT_305_AUDITAR.") (princ))
(defun C:M3_PRT_305_AUDITAR (/ ss n ok)
  (setq ss (ssget "X" '((8 . "M3P305-*"))) n (if ss (sslength ss) 0))
  (setq ok (and (> n 140) (tblsearch "LAYER" "M3P305-CONTORNO")
    (tblsearch "LAYER" "M3P305-COTA") (tblsearch "LAYER" "M3P305-EIXO")
    (tblsearch "LAYER" "M3P305-HACHURA")))
  (princ "\n--- AUDITORIA M3-PRT-305 ---")
  (princ (strcat "\nEntidades M3P305: " (itoa n)))
  (princ "\nGeometria: z60 m1.5 alfa20 d90 da87 df93.75 db84.572 b15.")
  (princ "\nFixacao P0: OD124 h7; 6x4.5 PCD112; validar parafusos M4.")
  (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO, regenere a folha."))
  (princ))
(princ "\nM3-PRT-305 carregada. Comandos: M3_PRT_305_GERAR e M3_PRT_305_AUDITAR.")
(princ)
