 (M3D001:text '(30 78 0)3"P302-P304 PERMANECEM; P307 USA MESMA GEOMETRIA.""M3D001-TEXTO")
 (M3D001:rect 245 78 395 130 "M3D001-TABELA")(M3D001:text '(250 123 0)4.5"CRITERIOS DE LIBERACAO CAD""M3D001-TEXTO")
 (M3D001:text '(250 115 0)3"1. QUATRO CONTATOS SIMULTANEOS SEM INTERFERENCIA.""M3D001-TEXTO")
 (M3D001:text '(250 107 0)3"2. BACKLASH 0,10-0,20 NOS 4 PLANETAS.""M3D001-TEXTO")
 (M3D001:text '(250 99 0)3"3. GIRO 360%%d E 100 VOLTAS SEM TRAVAR.""M3D001-TEXTO")
 (M3D001:text '(250 91 0)3"4. CONTATO AZUL 60-80%% DA LARGURA.""M3D001-TEXTO")
 (M3D001:text '(250 83 0)3"5. RELACAO MEDIDA 4:1 +/-1%%.""M3D001-TEXTO"))
(defun C:M3_AUD_001_GERAR(/ ss)
 (M3D001:savevars)(setq *M3D001-OLDERR* *error* *error* M3D001:error)(setvar "CMDECHO" 0)(setvar "OSMODE" 0)(setvar "ORTHOMODE" 0)(setvar "INSUNITS" 4)
 (M3D001:layer "M3D001-MARGEM" 7 "Continuous" 50)(M3D001:layer "M3D001-CARIMBO" 7 "Continuous" 25)(M3D001:layer "M3D001-TEXTO" 7 "Continuous" 25)
 (M3D001:layer "M3D001-APROVADO" 3 "Continuous" 50)(M3D001:layer "M3D001-BLOQUEADO" 1 "Continuous" 50)(M3D001:layer "M3D001-TABELA" 7 "Continuous" 25)
 (setq ss(ssget "X" '((8 . "M3D001-*"))))(if ss(command "_.ERASE" ss ""))(M3D001:draw)(command "_.ZOOM" "_E")(M3D001:restorevars)(setq *error* *M3D001-OLDERR*)
 (princ "\nM3-AUD-001 gerada. Execute M3_AUD_001_AUDITAR.")(princ))
(defun C:M3_AUD_001_AUDITAR(/ ss n ok)
 (setq ss(ssget "X" '((8 . "M3D001-*"))) n(if ss(sslength ss)0))(setq ok(and(> n 70)(tblsearch "LAYER" "M3D001-APROVADO")(tblsearch "LAYER" "M3D001-BLOQUEADO")))
 (princ "\n--- AUDITORIA M3-AUD-001 ---")(princ(strcat "\nEntidades: "(itoa n)))(princ "\nDECISAO: 4 planetas a 90 graus; 3 planetas bloqueados.")
 (if ok(princ "\nRESULTADO ESTATICO: APROVADO.")(princ "\nRESULTADO: REPROVADO."))(princ))
(princ "\nM3-AUD-001 carregada. Comandos: M3_AUD_001_GERAR e M3_AUD_001_AUDITAR.")(princ)
