  (M3P406:rect 245.0 20.0 400.0 70.0 "M3P406-CARIMBO")
  (foreach y '(30.0 40.0 50.0 60.0) (M3P406:line (list 245.0 y 0.0) (list 400.0 y 0.0) "M3P406-CARIMBO"))
  (M3P406:line '(315.0 20.0 0.0) '(315.0 60.0 0.0) "M3P406-CARIMBO")
  (M3P406:text '(248.0 65.0 0.0) 3.5 "CENTRO PAULA SOUZA / ETEC" "M3P406-TEXTO" "ML")
  (M3P406:text '(248.0 55.0 0.0) 3.5 "PROJETO: M3-PLN REDUTOR EPICICLICO 4:1" "M3P406-TEXTO" "ML")
  (M3P406:text '(248.0 45.0 0.0) 3.5 "M3-PRT-406 - ESPACADOR PLANETARIO" "M3P406-TEXTO" "ML")
  (M3P406:text '(248.0 35.0 0.0) 3.0 "MAT.: BRONZE SAE 660 | QT.: 8" "M3P406-TEXTO" "ML")
  (M3P406:text '(318.0 35.0 0.0) 3.0 "MASSA UNIT.: 0,0025 kg | LOTE: 0,020 kg" "M3P406-TEXTO" "ML")
  (M3P406:text '(248.0 25.0 0.0) 3.0 "ESCALA 8:1 | UNID. mm | 1o DIEDRO" "M3P406-TEXTO" "ML")
  (M3P406:text '(318.0 25.0 0.0) 3.0 "REV. R1 | FOLHA 1/1 | 2026-11-21" "M3P406-TEXTO" "ML")
  (M3P406:text '(248.0 15.0 0.0) 2.5 "STATUS: FINAL DE PROTOTIPO P0 - VALIDAR PILHA AXIAL" "M3P406-TEXTO" "ML"))
