(defun C:M3_PRT_503_GERAR (/ ss)
 (M3P503:savevars) (setq *M3P503-OLDERR* *error* *error* M3P503:error)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P503:layer "M3P503-MARGEM" 7 "Continuous" 50) (M3P503:layer "M3P503-CARIMBO" 7 "Continuous" 25)
 (M3P503:layer "M3P503-CONTORNO" 7 "Continuous" 50) (M3P503:layer "M3P503-COTA" 2 "Continuous" 25)
 (M3P503:layer "M3P503-TEXTO" 7 "Continuous" 25) (M3P503:layer "M3P503-EIXO" 4 "CENTER2" 25)
 (M3P503:layer "M3P503-OCULTA" 3 "HIDDEN2" 25) (M3P503:layer "M3P503-HACHURA" 8 "Continuous" 18)
 (M3P503:layer "M3P503-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P503-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P503:draw) (command "_.ZOOM" "_E") (M3P503:restorevars) (setq *error* *M3P503-OLDERR*)
 (princ "\nM3-PRT-503 R0 gerada. Execute M3_PRT_503_AUDITAR.") (princ))
(defun C:M3_PRT_503_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P503-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 120) (tblsearch "LAYER" "M3P503-CONTORNO") (tblsearch "LAYER" "M3P503-COTA") (tblsearch "LAYER" "M3P503-HACHURA")))
 (princ "\n--- AUDITORIA M3-PRT-503 ---") (princ (strcat "\nEntidades M3P503: " (itoa n)))
 (princ "\nGeometria: corpo50x20; 2 pilotos25g6x4; total28; furo15H7.")
 (princ "\nFixacao: 3 M5 por face em PCD40; rasgo 5JS9x2.3.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-503 carregada. Comandos: M3_PRT_503_GERAR e M3_PRT_503_AUDITAR.")
(princ)
