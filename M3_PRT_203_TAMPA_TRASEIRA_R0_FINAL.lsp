(defun C:M3_PRT_203_GERAR (/ ss)
 (M3P203:savevars) (setq *M3P203-OLDERR* *error* *error* M3P203:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P203:layer "M3P203-MARGEM" 7 "Continuous" 50) (M3P203:layer "M3P203-CARIMBO" 7 "Continuous" 25) (M3P203:layer "M3P203-CONTORNO" 7 "Continuous" 50)
 (M3P203:layer "M3P203-COTA" 2 "Continuous" 25) (M3P203:layer "M3P203-TEXTO" 7 "Continuous" 25) (M3P203:layer "M3P203-EIXO" 4 "CENTER2" 25)
 (M3P203:layer "M3P203-OCULTA" 3 "HIDDEN2" 25) (M3P203:layer "M3P203-HACHURA" 8 "Continuous" 18) (M3P203:layer "M3P203-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P203-*")))) (if ss (command "_.ERASE" ss "")) (M3P203:draw) (command "_.ZOOM" "_E") (M3P203:restorevars) (setq *error* *M3P203-OLDERR*)
 (princ "\nM3-PRT-203 R0 gerada. Execute M3_PRT_203_AUDITAR.") (princ))
(defun C:M3_PRT_203_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P203-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 105) (tblsearch "LAYER" "M3P203-CONTORNO") (tblsearch "LAYER" "M3P203-HACHURA")))
 (princ "\n--- AUDITORIA M3-PRT-203 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: OD160x10 piloto123.95g6x4 rolamento35H7x11 PCD148.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-203 carregada. Comandos: M3_PRT_203_GERAR e M3_PRT_203_AUDITAR.")
(princ)
