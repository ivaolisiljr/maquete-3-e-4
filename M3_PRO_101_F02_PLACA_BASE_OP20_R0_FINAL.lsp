(defun C:M3_PRO_101_F02_GERAR (/ ss)
 (M3P101F02:sv) (setq *M3P101F02-ERR* *error* *error* M3P101F02:er)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (foreach a '(("M3P101F02-BORDA" 7 "Continuous" 50)("M3P101F02-TABELA" 7 "Continuous" 25)("M3P101F02-TEXTO" 7 "Continuous" 25)("M3P101F02-CODIGO" 1 "Continuous" 35)("M3P101F02-PECA" 7 "Continuous" 50)("M3P101F02-PASSE" 3 "HIDDEN2" 25)("M3P101F02-AVANCO" 4 "Continuous" 35)("M3P101F02-FERRAMENTA" 1 "Continuous" 50)("M3P101F02-FIXACAO" 6 "Continuous" 50)("M3P101F02-MESA" 8 "Continuous" 50)("M3P101F02-DATUM" 2 "Continuous" 35)) (M3P101F02:lay (car a) (cadr a) (caddr a) (cadddr a)))
 (setq ss (ssget "X" '((8 . "M3P101F02-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P101F02:draw) (command "_.ZOOM" "_E") (M3P101F02:rv) (setq *error* *M3P101F02-ERR*)
 (princ "\nM3-PRO-101-F02 gerada. Execute M3_PRO_101_F02_AUDITAR.") (princ))
(defun C:M3_PRO_101_F02_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P101F02-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 125) (tblsearch "LAYER" "M3P101F02-DATUM") (tblsearch "LAYER" "M3P101F02-FIXACAO") (tblsearch "LAYER" "M3P101F02-PASSE")))
 (princ "\n--- AUDITORIA M3-PRO-101-F02 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nOperacao 20: primeira face, datum A, n910, Vf455, ap0.8-1.0/0.30, planicidade preliminar 0.30.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRO-101-F02 carregada. Comandos: M3_PRO_101_F02_GERAR e M3_PRO_101_F02_AUDITAR.") (princ)
