(defun M3P101F02:ci (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P101F02:arr (p1 p2 l / a q1 q2) (M3P101F02:ln p1 p2 l) (setq a (angle p1 p2) q1 (polar p2 (+ a 2.65) 4.0) q2 (polar p2 (- a 2.65) 4.0)) (M3P101F02:ln p2 q1 l) (M3P101F02:ln p2 q2 l))
