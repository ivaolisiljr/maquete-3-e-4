; M3-PRT-406 - ESPACADOR PLANETARIO - R1 FINAL DE PROTOTIPO
; Projeto M3-PLN - redutor planetario didatico 4:1
; Uma folha A3 por arquivo / unidades mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_406_GERAR e M3_PRT_406_AUDITAR
; Quantidade: 8 (dois por planeta, quatro planetas). Geometria P0: OD16, ID10.2 H11, espessura 2.35 +/-0.05.
; Cadeia axial nominal: pino32 - placas12 = vao20; planeta15 + 2x2.35 = 19.70; folga total 0.30.
(vl-load-com)
(setq *M3P406-OLDERR* nil *M3P406-OLDVARS* nil)
(defun M3P406:savevars ()
  (setq *M3P406-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n)))
    '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "LTSCALE" "CELTSCALE" "INSUNITS"))))
(defun M3P406:restorevars ()
  (if *M3P406-OLDVARS* (foreach p *M3P406-OLDVARS* (if (cdr p) (setvar (car p) (cdr p)))))
  (setq *M3P406-OLDVARS* nil))
(defun M3P406:error (msg)
  (M3P406:restorevars)
  (if (and msg (/= msg "Function cancelled") (/= msg "quit / exit abort"))
    (princ (strcat "\nM3-PRT-406 ERRO: " msg)))
  (setq *error* *M3P406-OLDERR*) (princ))
(defun M3P406:layer (n c lt lw)
  (if (not (tblsearch "LAYER" n))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
      (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P406:line (a b l)
  (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P406:circle (c r l)
  (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P406:text (p h tx l j / d)
  (setq d (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText")
    (cons 10 p) (cons 40 h) (cons 1 tx) (cons 7 "Standard") (cons 50 0.0)))
  (if (= j "MC") (setq d (append d (list (cons 72 1) (cons 73 2) (cons 11 p))))
    (setq d (append d (list (cons 72 0) (cons 73 2) (cons 11 p)))))
  (entmake d))
(defun M3P406:rect (x1 y1 x2 y2 l)
  (M3P406:line (list x1 y1 0.0) (list x2 y1 0.0) l) (M3P406:line (list x2 y1 0.0) (list x2 y2 0.0) l)
  (M3P406:line (list x2 y2 0.0) (list x1 y2 0.0) l) (M3P406:line (list x1 y2 0.0) (list x1 y1 0.0) l))
(defun M3P406:arrow (p a z l)
  (M3P406:line p (polar p (+ a 2.65) z) l) (M3P406:line p (polar p (- a 2.65) z) l))
(defun M3P406:dimH (x1 x2 yo yd tx / a b)
  (setq a (list x1 yd 0.0) b (list x2 yd 0.0))
  (M3P406:line (list x1 yo 0.0) a "M3P406-COTA") (M3P406:line (list x2 yo 0.0) b "M3P406-COTA")
  (M3P406:line a b "M3P406-COTA") (M3P406:arrow a 0.0 2.0 "M3P406-COTA") (M3P406:arrow b pi 2.0 "M3P406-COTA")
  (M3P406:text (list (/ (+ x1 x2) 2.0) (+ yd 2.4) 0.0) 3.5 tx "M3P406-TEXTO" "MC"))
(defun M3P406:dimV (y1 y2 xo xd tx / a b)
  (setq a (list xd y1 0.0) b (list xd y2 0.0))
  (M3P406:line (list xo y1 0.0) a "M3P406-COTA") (M3P406:line (list xo y2 0.0) b "M3P406-COTA")
  (M3P406:line a b "M3P406-COTA") (M3P406:arrow a (/ pi 2.0) 2.0 "M3P406-COTA")
  (M3P406:arrow b (* 1.5 pi) 2.0 "M3P406-COTA")
  (M3P406:text (list (+ xd 3.0) (/ (+ y1 y2) 2.0) 0.0) 3.5 tx "M3P406-TEXTO" "ML"))
(defun M3P406:hatch (x1 y1 x2 y2 st / x)
  (setq x (- x1 (- y2 y1)))
  (while (< x x2)
    (M3P406:line (list (max x1 x) (+ y1 (max 0.0 (- x1 x))) 0.0)
      (list (min x2 (+ x (- y2 y1))) (min y2 (+ y1 (- x2 x))) 0.0) "M3P406-HACHURA")
    (setq x (+ x st))))
