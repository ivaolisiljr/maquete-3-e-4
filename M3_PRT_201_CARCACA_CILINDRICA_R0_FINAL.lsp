; M3-PRT-201 - CARCACA CILINDRICA - R0 FINAL DE PROTOTIPO
; M3-PLN / A3 horizontal / mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_201_GERAR e M3_PRT_201_AUDITAR
; P0: tubo OD140, ID124 H7, L80; flanges OD160x8; 8 furos 6.6 PCD148;
; alojamento da coroa OD124 h7; janela superior 70x45; pes 2x M8.
(vl-load-com)
(setq *M3P201-OLDERR* nil *M3P201-OLDVARS* nil)
(defun M3P201:savevars () (setq *M3P201-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3P201:restorevars () (if *M3P201-OLDVARS* (foreach p *M3P201-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P201-OLDVARS* nil))
(defun M3P201:error (m) (M3P201:restorevars) (if (and m (/= m "Function cancelled")) (princ (strcat "\nM3-PRT-201 ERRO: " m))) (setq *error* *M3P201-OLDERR*) (princ))
(defun M3P201:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P201:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P201:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P201:text (p h x l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 x) (cons 7 "Standard"))))
(defun M3P201:rect (x1 y1 x2 y2 l) (M3P201:line (list x1 y1 0) (list x2 y1 0) l) (M3P201:line (list x2 y1 0) (list x2 y2 0) l) (M3P201:line (list x2 y2 0) (list x1 y2 0) l) (M3P201:line (list x1 y2 0) (list x1 y1 0) l))
(defun M3P201:hatch (x1 y1 x2 y2 / x) (setq x x1) (while (< x x2) (M3P201:line (list x y1 0) (list (min x2 (+ x (- y2 y1))) y2 0) "M3P201-HACHURA") (setq x (+ x 4))))
