; Comandos: M3_PRT_103_GERAR e M3_PRT_103_AUDITAR
; P0: base 140x70x10; alma 120x145x10; berco R70, centro a 95 da base;
; 4 furos base 9x14 para M8; 2 furos carcaca 9 em passo 110; solda filete a6.
(vl-load-com)
(setq *M3P103-OLDERR* nil *M3P103-OLDVARS* nil)
(defun M3P103:savevars () (setq *M3P103-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3P103:restorevars () (if *M3P103-OLDVARS* (foreach p *M3P103-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P103-OLDVARS* nil))
(defun M3P103:error (m) (M3P103:restorevars) (if (and m (/= m "Function cancelled")) (princ (strcat "\nM3-PRT-103 ERRO: " m))) (setq *error* *M3P103-OLDERR*) (princ))
(defun M3P103:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P103:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P103:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P103:arc (c r a1 a2 l) (entmake (list '(0 . "ARC") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r) '(100 . "AcDbArc") (cons 50 a1) (cons 51 a2))))
(defun M3P103:text (p h x l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 x) (cons 7 "Standard"))))
(defun M3P103:rect (x1 y1 x2 y2 l) (M3P103:line (list x1 y1 0) (list x2 y1 0) l) (M3P103:line (list x2 y1 0) (list x2 y2 0) l) (M3P103:line (list x2 y2 0) (list x1 y2 0) l) (M3P103:line (list x1 y2 0) (list x1 y1 0) l))
