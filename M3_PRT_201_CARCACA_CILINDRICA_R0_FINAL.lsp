(defun C:M3_PRT_201_GERAR (/ ss)
 (M3P201:savevars) (setq *M3P201-OLDERR* *error* *error* M3P201:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P201:layer "M3P201-MARGEM" 7 "Continuous" 50) (M3P201:layer "M3P201-CARIMBO" 7 "Continuous" 25) (M3P201:layer "M3P201-CONTORNO" 7 "Continuous" 50)
 (M3P201:layer "M3P201-COTA" 2 "Continuous" 25) (M3P201:layer "M3P201-TEXTO" 7 "Continuous" 25) (M3P201:layer "M3P201-EIXO" 4 "CENTER2" 25)
 (M3P201:layer "M3P201-OCULTA" 3 "HIDDEN2" 25) (M3P201:layer "M3P201-HACHURA" 8 "Continuous" 18) (M3P201:layer "M3P201-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P201-*")))) (if ss (command "_.ERASE" ss "")) (M3P201:draw) (command "_.ZOOM" "_E") (M3P201:restorevars) (setq *error* *M3P201-OLDERR*)
 (princ "\nM3-PRT-201 R0 gerada. Execute M3_PRT_201_AUDITAR.") (princ))
(defun C:M3_PRT_201_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P201-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 110) (tblsearch "LAYER" "M3P201-CONTORNO") (tblsearch "LAYER" "M3P201-HACHURA")))
 (princ "\n--- AUDITORIA M3-PRT-201 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: OD140 ID124H7 L80 flanges160x8 janela70x45.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-201 carregada. Comandos: M3_PRT_201_GERAR e M3_PRT_201_AUDITAR.")
(princ)
