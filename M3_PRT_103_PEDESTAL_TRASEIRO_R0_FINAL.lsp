(defun C:M3_PRT_103_GERAR (/ ss)
 (M3P103:savevars) (setq *M3P103-OLDERR* *error* *error* M3P103:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P103:layer "M3P103-MARGEM" 7 "Continuous" 50) (M3P103:layer "M3P103-CARIMBO" 7 "Continuous" 25) (M3P103:layer "M3P103-CONTORNO" 7 "Continuous" 50)
 (M3P103:layer "M3P103-COTA" 2 "Continuous" 25) (M3P103:layer "M3P103-TEXTO" 7 "Continuous" 25) (M3P103:layer "M3P103-EIXO" 4 "CENTER2" 25) (M3P103:layer "M3P103-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P103-*")))) (if ss (command "_.ERASE" ss "")) (M3P103:draw) (command "_.ZOOM" "_E") (M3P103:restorevars) (setq *error* *M3P103-OLDERR*)
 (princ "\nM3-PRT-103 R0 gerada. Execute M3_PRT_103_AUDITAR.") (princ))
(defun C:M3_PRT_103_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P103-*"))) n (if ss (sslength ss) 0)) (setq ok (and (> n 90) (tblsearch "LAYER" "M3P103-CONTORNO")))
 (princ "\n--- AUDITORIA M3-PRT-103 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: base140x70x10 alma120x145x10 bercoR70 altura95; par P102.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-103 carregada. Comandos: M3_PRT_103_GERAR e M3_PRT_103_AUDITAR.") (princ)
