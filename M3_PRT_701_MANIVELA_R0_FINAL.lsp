; Comandos: M3_PRT_701_GERAR e M3_PRT_701_AUDITAR
; P0: braco 140 x 25 x 8; cubo OD30 x 18, furo 12 H7 e rasgo 4 JS9;
; raio 100 ao manopulo; pino manopulo M8 x 35; retencao axial M6.
(vl-load-com)
(setq *M3P701-OLDERR* nil *M3P701-OLDVARS* nil)
(defun M3P701:savevars () (setq *M3P701-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3P701:restorevars () (if *M3P701-OLDVARS* (foreach p *M3P701-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P701-OLDVARS* nil))
(defun M3P701:error (m) (M3P701:restorevars) (if (and m (/= m "Function cancelled")) (princ (strcat "\nM3-PRT-701 ERRO: " m))) (setq *error* *M3P701-OLDERR*) (princ))
(defun M3P701:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P701:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P701:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P701:text (p h x l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 x) (cons 7 "Standard"))))
(defun M3P701:rect (x1 y1 x2 y2 l) (M3P701:line (list x1 y1 0) (list x2 y1 0) l) (M3P701:line (list x2 y1 0) (list x2 y2 0) l) (M3P701:line (list x2 y2 0) (list x1 y2 0) l) (M3P701:line (list x1 y2 0) (list x1 y1 0) l))
