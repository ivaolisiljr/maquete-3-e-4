 (foreach a '(0.0 1.5707963268 3.1415926536 4.7123889804) (setq p(polar c a 30))(M3D001:circle p 16.5 "M3D001-APROVADO"))
 (M3D001:text '(203 138 0)5"OPCAO B - 4 PLANETAS / 90 GRAUS""M3D001-APROVADO")
