(defun C:M3_PRT_302_GERAR (/ ss)
  (M3P302:savevars)
  (setq *M3P302-OLDERR* *error* *error* M3P302:error)
  (setvar "CMDECHO" 0)
  (setvar "OSMODE" 0)
  (setvar "ORTHOMODE" 0)
  (setvar "INSUNITS" 4)
  (M3P302:layer "M3P302-MARGEM" 7 "Continuous" 50)
  (M3P302:layer "M3P302-CARIMBO" 7 "Continuous" 25)
  (M3P302:layer "M3P302-CONTORNO" 7 "Continuous" 50)
  (M3P302:layer "M3P302-COTA" 2 "Continuous" 25)
  (M3P302:layer "M3P302-TEXTO" 7 "Continuous" 25)
  (M3P302:layer "M3P302-EIXO" 4 "CENTER2" 25)
  (M3P302:layer "M3P302-OCULTA" 3 "HIDDEN2" 25)
  (M3P302:layer "M3P302-HACHURA" 8 "Continuous" 18)
  (M3P302:layer "M3P302-AUX" 8 "Continuous" 18)
  (M3P302:layer "M3P302-TABELA" 7 "Continuous" 25)
  ; Limpa somente entidades deste namespace
  (setq ss (ssget "X" '((8 . "M3P302-*"))))
  (if ss (command "_.ERASE" ss ""))
  (M3P302:draw)
  (command "_.ZOOM" "_E")
  (M3P302:restorevars)
  (setq *error* *M3P302-OLDERR*)
  (princ "\nM3-PRT-302 R0 gerada. Execute M3_PRT_302_AUDITAR.")
  (princ)
)

(defun C:M3_PRT_302_AUDITAR (/ ss n ok)
  (setq ss (ssget "X" '((8 . "M3P302-*"))))
  (setq n (if ss (sslength ss) 0))
  (setq ok (and (> n 150)
                (tblsearch "LAYER" "M3P302-CONTORNO")
                (tblsearch "LAYER" "M3P302-COTA")
                (tblsearch "LAYER" "M3P302-EIXO")
                (tblsearch "LAYER" "M3P302-OCULTA")))
  (princ "\n--- AUDITORIA M3-PRT-302 ---")
  (princ (strcat "\nEntidades do namespace: " (itoa n)))
  (princ "\nFolha: A3 420x297; margem util 380x257.")
  (princ "\nGeometria: m1.5, z20, d30, da33, df26.25, db28.191, b15.")
  (princ "\nInterface: furo 10 H7 / pino 10 g6; datum A; folga axial 0,20-0,40.")
  (princ "\nStatus: P0, obrigatoria validacao CAD de backlash e interferencia.")
  (if ok
    (princ "\nRESULTADO ESTATICO: APROVADO - elementos minimos presentes.")
    (princ "\nRESULTADO ESTATICO: REPROVADO - regenere a folha e revise layers."))
  (princ)
)

(princ "\nM3-PRT-302 carregada. Comandos: M3_PRT_302_GERAR e M3_PRT_302_AUDITAR.")
(princ)
