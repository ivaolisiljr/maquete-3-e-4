(defun C:M3_PRT_502_GERAR (/ ss)
 (M3P502:savevars) (setq *M3P502-OLDERR* *error* *error* M3P502:error)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P502:layer "M3P502-MARGEM" 7 "Continuous" 50) (M3P502:layer "M3P502-CARIMBO" 7 "Continuous" 25)
 (M3P502:layer "M3P502-CONTORNO" 7 "Continuous" 50) (M3P502:layer "M3P502-COTA" 2 "Continuous" 25)
 (M3P502:layer "M3P502-TEXTO" 7 "Continuous" 25) (M3P502:layer "M3P502-EIXO" 4 "CENTER2" 25)
 (M3P502:layer "M3P502-OCULTA" 3 "HIDDEN2" 25) (M3P502:layer "M3P502-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P502-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P502:draw) (command "_.ZOOM" "_E") (M3P502:restorevars) (setq *error* *M3P502-OLDERR*)
 (princ "\nM3-PRT-502 R0 gerada. Execute M3_PRT_502_AUDITAR.") (princ))
(defun C:M3_PRT_502_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P502-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 125) (tblsearch "LAYER" "M3P502-CONTORNO") (tblsearch "LAYER" "M3P502-COTA") (tblsearch "LAYER" "M3P502-EIXO")))
 (princ "\n--- AUDITORIA M3-PRT-502 ---") (princ (strcat "\nEntidades M3P502: " (itoa n)))
 (princ "\nArquitetura: L100; 2x15k6x11; cubo15h6x18; saida12h6x24.")
 (princ "\nElementos: 6202-2RS; chavetas 4x4 e 5x5; M10 externo e M6 interno.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-502 carregada. Comandos: M3_PRT_502_GERAR e M3_PRT_502_AUDITAR.")
(princ)
