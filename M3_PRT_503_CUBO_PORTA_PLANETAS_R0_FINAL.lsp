; M3-PRT-503 - CUBO PORTA-PLANETAS - R0 FINAL DE PROTOTIPO
; Projeto M3-PLN - redutor planetario didatico 4:1
; Uma folha A3 por arquivo / unidades mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_503_GERAR e M3_PRT_503_AUDITAR
; Arquitetura P0: corpo OD50x20; dois pilotos OD25g6x4; total 28; furo 15H7;
; rasgo 5JS9x2.3; 3 roscas M5-6H em PCD40, profundidade 7, em cada face.
(vl-load-com)
(setq *M3P503-OLDERR* nil *M3P503-OLDVARS* nil)
(defun M3P503:savevars () (setq *M3P503-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS" "LTSCALE" "CELTSCALE"))))
(defun M3P503:restorevars () (if *M3P503-OLDVARS* (foreach p *M3P503-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P503-OLDVARS* nil))
(defun M3P503:error (m) (M3P503:restorevars) (if (and m (/= m "Function cancelled") (/= m "quit / exit abort")) (princ (strcat "\nM3-PRT-503 ERRO: " m))) (setq *error* *M3P503-OLDERR*) (princ))
(defun M3P503:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P503:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P503:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P503:text (p h tx l j / d) (setq d (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 tx) (cons 7 "Standard") (cons 50 0.0))) (if (= j "MC") (setq d (append d (list (cons 72 1) (cons 73 2) (cons 11 p)))) (setq d (append d (list (cons 72 0) (cons 73 2) (cons 11 p))))) (entmake d))
(defun M3P503:rect (x1 y1 x2 y2 l) (M3P503:line (list x1 y1 0) (list x2 y1 0) l) (M3P503:line (list x2 y1 0) (list x2 y2 0) l) (M3P503:line (list x2 y2 0) (list x1 y2 0) l) (M3P503:line (list x1 y2 0) (list x1 y1 0) l))
(defun M3P503:arrow (p a z l) (M3P503:line p (polar p (+ a 2.65) z) l) (M3P503:line p (polar p (- a 2.65) z) l))
(defun M3P503:dimH (x1 x2 yo yd tx / a b) (setq a (list x1 yd 0) b (list x2 yd 0)) (M3P503:line (list x1 yo 0) a "M3P503-COTA") (M3P503:line (list x2 yo 0) b "M3P503-COTA") (M3P503:line a b "M3P503-COTA") (M3P503:arrow a 0 2 "M3P503-COTA") (M3P503:arrow b pi 2 "M3P503-COTA") (M3P503:text (list (/ (+ x1 x2) 2) (+ yd 2.3) 0) 3.2 tx "M3P503-TEXTO" "MC"))
(defun M3P503:hatch (x1 y1 x2 y2 st / x) (setq x (- x1 (- y2 y1))) (while (< x x2) (M3P503:line (list (max x1 x) (+ y1 (max 0 (- x1 x))) 0) (list (min x2 (+ x (- y2 y1))) (min y2 (+ y1 (- x2 x))) 0) "M3P503-HACHURA") (setq x (+ x st))))
