; M3-PRT-101 - PLACA-BASE - R0 FINAL DE PROTOTIPO
; Projeto M3-PLN / folha A3 horizontal / unidades mm / AutoCAD Mechanical 2025 PT-BR
; Comandos: M3_PRT_101_GERAR e M3_PRT_101_AUDITAR
; P0: placa 260 x 180 x 10, cantos R10; 8 rasgos 9 x 14 para pedestais;
; 4 furos 11 para fixacao da base; malha principal 220 x 140; pe de borracha opcional.
(vl-load-com)
(setq *M3P101-OLDERR* nil *M3P101-OLDVARS* nil)
(defun M3P101:savevars () (setq *M3P101-OLDVARS* (mapcar '(lambda (n) (cons n (getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3P101:restorevars () (if *M3P101-OLDVARS* (foreach p *M3P101-OLDVARS* (if (cdr p) (setvar (car p) (cdr p))))) (setq *M3P101-OLDVARS* nil))
(defun M3P101:error (m) (M3P101:restorevars) (if (and m (/= m "Function cancelled")) (princ (strcat "\nM3-PRT-101 ERRO: " m))) (setq *error* *M3P101-OLDERR*) (princ))
(defun M3P101:layer (n c lt lw) (if (not (tblsearch "LAYER" n)) (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 n) (cons 70 0) (cons 62 c) (cons 6 lt) (cons 370 lw)))))
(defun M3P101:line (a b l) (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbLine") (cons 10 a) (cons 11 b))))
(defun M3P101:circle (c r l) (entmake (list '(0 . "CIRCLE") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 c) (cons 40 r))))
(defun M3P101:text (p h x l) (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbText") (cons 10 p) (cons 40 h) (cons 1 x) (cons 7 "Standard"))))
(defun M3P101:rect (x1 y1 x2 y2 l) (M3P101:line (list x1 y1 0) (list x2 y1 0) l) (M3P101:line (list x2 y1 0) (list x2 y2 0) l) (M3P101:line (list x2 y2 0) (list x1 y2 0) l) (M3P101:line (list x1 y2 0) (list x1 y1 0) l))
(defun M3P101:slot (c len wid l / x y r h)
 (setq x (car c) y (cadr c) r (/ wid 2.0) h (/ (- len wid) 2.0))
 (M3P101:line (list (- x h) (- y r) 0) (list (+ x h) (- y r) 0) l)
 (M3P101:line (list (- x h) (+ y r) 0) (list (+ x h) (+ y r) 0) l)
 (entmake (list '(0 . "ARC") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 (list (- x h) y 0)) (cons 40 r) '(100 . "AcDbArc") (cons 50 (/ pi 2)) (cons 51 (* 1.5 pi))))
 (entmake (list '(0 . "ARC") '(100 . "AcDbEntity") (cons 8 l) '(100 . "AcDbCircle") (cons 10 (list (+ x h) y 0)) (cons 40 r) '(100 . "AcDbArc") (cons 50 (* 1.5 pi)) (cons 51 (* 2.5 pi)))))
(defun M3P101:frame ()
 (M3P101:rect 10 10 410 287 "M3P101-MARGEM") (M3P101:rect 20 20 400 277 "M3P101-MARGEM")
 (M3P101:rect 245 20 400 70 "M3P101-CARIMBO") (foreach y '(30 40 50 60) (M3P101:line (list 245 y 0) (list 400 y 0) "M3P101-CARIMBO"))
 (M3P101:text '(248 64 0) 3.5 "PROJETO: M3-PLN REDUTOR EPICICLICO 4:1" "M3P101-TEXTO")
 (M3P101:text '(248 54 0) 3.5 "M3-PRT-101 - PLACA-BASE" "M3P101-TEXTO")
 (M3P101:text '(248 44 0) 3 "MAT.: ASTM A36 / CHAPA USINADA" "M3P101-TEXTO")
 (M3P101:text '(248 34 0) 3 "MASSA APROX.: 3,58 kg | ESCALA 1:2" "M3P101-TEXTO")
 (M3P101:text '(248 24 0) 3 "UNID. mm | 1o DIEDRO | REV. R0 | FOLHA 1/1" "M3P101-TEXTO")
 (M3P101:text '(248 14 0) 2.5 "FINAL DE PROTOTIPO P0 - VALIDAR NO CAD" "M3P101-TEXTO"))
(defun M3P101:draw (/ slots)
 (M3P101:frame) (M3P101:text '(25 268 0) 7 "M3-PRT-101 - PLACA-BASE" "M3P101-TEXTO")
 (M3P101:text '(25 259 0) 3.5 "BASE DO CONJUNTO COM AJUSTE LONGITUDINAL DOS DOIS PEDESTAIS" "M3P101-TEXTO")
 ; top view scale 1:2, 260x180 -> 130x90
 (M3P101:rect 35 145 165 235 "M3P101-CONTORNO")
 ; pedestal slots: groups centered x70 and130 drawing coords, local 55x20 nominal -> 27.5x10 drawing
 (setq slots '((55 170)(82.5 170)(55 210)(82.5 210)(117.5 170)(145 170)(117.5 210)(145 210)))
 (foreach p slots (M3P101:slot p 7 4.5 "M3P101-CONTORNO"))
 ; foundation holes nominal 220x140, scaled: corners offsets 10 each
 (foreach p '((45 155)(155 155)(45 225)(155 225)) (M3P101:circle p 2.75 "M3P101-CONTORNO"))
 (M3P101:line '(28 190 0) '(172 190 0) "M3P101-EIXO") (M3P101:line '(100 138 0) '(100 242 0) "M3P101-EIXO")
 (M3P101:text '(75 136 0) 5 "VISTA SUPERIOR" "M3P101-TEXTO")
 (M3P101:text '(35 248 0) 3.2 "260 x 180 x 10 / CANTOS R10" "M3P101-TEXTO")
 (M3P101:text '(35 241 0) 3.2 "8 RASGOS 9 x 14 PARA M8 / GRUPOS DOS PEDESTAIS" "M3P101-TEXTO")
 (M3P101:text '(35 128 0) 3.2 "4 x %%c11 PASSANTES EM MALHA 220 x 140" "M3P101-TEXTO")
 ; front/side
 (M3P101:rect 205 185 335 190 "M3P101-CONTORNO")
 (M3P101:text '(245 174 0) 5 "VISTA FRONTAL" "M3P101-TEXTO")
 (M3P101:text '(205 200 0) 3.2 "ESPESSURA 10 +/-0,15" "M3P101-TEXTO")
 (M3P101:rect 355 145 360 235 "M3P101-CONTORNO")
 (M3P101:text '(342 136 0) 5 "VISTA LATERAL" "M3P101-TEXTO")
 ; detail/table
 (M3P101:rect 205 210 395 250 "M3P101-TABELA")
 (M3P101:text '(212 242 0) 4.5 "PADROES DE FIXACAO E DATUMS" "M3P101-TEXTO")
 (M3P101:text '(212 232 0) 3 "PEDESTAL FRONTAL: CENTRO X=75 P0" "M3P101-TEXTO")
 (M3P101:text '(212 224 0) 3 "PEDESTAL TRASEIRO: CENTRO X=185 P0" "M3P101-TEXTO")
 (M3P101:text '(212 216 0) 3 "DATUM A: FACE SUPERIOR / B: EIXO LONGITUDINAL" "M3P101-TEXTO")
 ; notes
 (M3P101:rect 25 78 235 122 "M3P101-TABELA") (M3P101:text '(30 115 0) 4.5 "NOTAS TECNICAS" "M3P101-TEXTO")
 (M3P101:text '(30 107 0) 3 "1. PLANICIDADE DA FACE SUPERIOR: 0,20; PARALELISMO 0,15." "M3P101-TEXTO")
 (M3P101:text '(30 100 0) 3 "2. RASGOS ORIENTADOS NO SENTIDO LONGITUDINAL PARA AJUSTE." "M3P101-TEXTO")
 (M3P101:text '(30 93 0) 3 "3. QUEBRAR ARESTAS 0,5; CANTOS EXTERNOS R10." "M3P101-TEXTO")
 (M3P101:text '(30 86 0) 3 "4. PINTURA RAL 5015; PROTEGER FACE SUPERIOR E FUROS." "M3P101-TEXTO")
 (M3P101:text '(30 79 0) 3 "5. P0: VALIDAR POSICAO DOS PEDESTAIS E CENTRO DO EIXO." "M3P101-TEXTO")
 (M3P101:rect 245 78 395 133 "M3P101-TABELA") (M3P101:text '(250 126 0) 4.5 "PLANO DE INSPECAO" "M3P101-TEXTO")
 (M3P101:text '(250 118 0) 3 "Dimensoes: trena calibrada, paquimetro e CMM." "M3P101-TEXTO")
 (M3P101:text '(250 110 0) 3 "Planicidade: relogio em mesa de desempeno." "M3P101-TEXTO")
 (M3P101:text '(250 102 0) 3 "Rasgos/furos: gabarito funcional e CMM." "M3P101-TEXTO")
 (M3P101:text '(250 94 0) 3 "Montagem: P102/P103, carcaca e nivelamento." "M3P101-TEXTO")
 (M3P101:text '(250 86 0) 3 "Aceite: sem oscilacao; eixos paralelos a base." "M3P101-TEXTO"))
(defun C:M3_PRT_101_GERAR (/ ss)
 (M3P101:savevars) (setq *M3P101-OLDERR* *error* *error* M3P101:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P101:layer "M3P101-MARGEM" 7 "Continuous" 50) (M3P101:layer "M3P101-CARIMBO" 7 "Continuous" 25) (M3P101:layer "M3P101-CONTORNO" 7 "Continuous" 50)
 (M3P101:layer "M3P101-COTA" 2 "Continuous" 25) (M3P101:layer "M3P101-TEXTO" 7 "Continuous" 25) (M3P101:layer "M3P101-EIXO" 4 "CENTER2" 25) (M3P101:layer "M3P101-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P101-*")))) (if ss (command "_.ERASE" ss "")) (M3P101:draw) (command "_.ZOOM" "_E") (M3P101:restorevars) (setq *error* *M3P101-OLDERR*)
 (princ "\nM3-PRT-101 R0 gerada. Execute M3_PRT_101_AUDITAR.") (princ))
(defun C:M3_PRT_101_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P101-*"))) n (if ss (sslength ss) 0)) (setq ok (and (> n 90) (tblsearch "LAYER" "M3P101-CONTORNO")))
 (princ "\n--- AUDITORIA M3-PRT-101 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: 260x180x10; 8 rasgos9x14; 4 furos11 malha220x140.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-101 carregada. Comandos: M3_PRT_101_GERAR e M3_PRT_101_AUDITAR.") (princ)
