(defun C:M3_PRO_101_F04_GERAR (/ ss)
 (M3P101F04:sv) (setq *M3P101F04-ERR* *error* *error* M3P101F04:er)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (foreach a '(("M3P101F04-BORDA" 7 "Continuous" 50)("M3P101F04-TABELA" 7 "Continuous" 25)("M3P101F04-TEXTO" 7 "Continuous" 25)("M3P101F04-CODIGO" 1 "Continuous" 35)("M3P101F04-BRUTO" 8 "Continuous" 50)("M3P101F04-ACABADO" 3 "HIDDEN2" 25)("M3P101F04-DATUM" 2 "Continuous" 35)("M3P101F04-AVANCO" 4 "Continuous" 35)("M3P101F04-FERRAMENTA" 1 "Continuous" 50)("M3P101F04-CONTROLE" 6 "CENTER2" 25)) (M3P101F04:lay (car a) (cadr a) (caddr a) (cadddr a)))
 (setq ss (ssget "X" '((8 . "M3P101F04-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P101F04:draw) (command "_.ZOOM" "_E") (M3P101F04:rv) (setq *error* *M3P101F04-ERR*)
 (princ "\nM3-PRO-101-F04 gerada. Execute M3_PRO_101_F04_AUDITAR.") (princ))
(defun C:M3_PRO_101_F04_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P101F04-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 125) (tblsearch "LAYER" "M3P101F04-DATUM") (tblsearch "LAYER" "M3P101F04-AVANCO") (tblsearch "LAYER" "M3P101F04-CONTROLE")))
 (princ "\n--- AUDITORIA M3-PRO-101-F04 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nOperacao 40: 260 +/-0.5 x 180 +/-0.5; esquadro 0.20/180; 4xR10 +/-0.5.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRO-101-F04 carregada. Comandos: M3_PRO_101_F04_GERAR e M3_PRO_101_F04_AUDITAR.") (princ)
