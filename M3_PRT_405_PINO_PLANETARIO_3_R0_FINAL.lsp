(defun C:M3_PRT_405_GERAR (/ ss)
  (M3P405:savevars) (setq *M3P405-OLDERR* *error* *error* M3P405:error)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
  (M3P405:layer "M3P405-MARGEM" 7 "Continuous" 50) (M3P405:layer "M3P405-CARIMBO" 7 "Continuous" 25)
  (M3P405:layer "M3P405-CONTORNO" 7 "Continuous" 50) (M3P405:layer "M3P405-COTA" 2 "Continuous" 25)
  (M3P405:layer "M3P405-TEXTO" 7 "Continuous" 25) (M3P405:layer "M3P405-EIXO" 4 "CENTER2" 25)
  (M3P405:layer "M3P405-OCULTA" 3 "HIDDEN2" 25) (M3P405:layer "M3P405-HACHURA" 8 "Continuous" 18)
  (M3P405:layer "M3P405-TABELA" 7 "Continuous" 25)
  (setq ss (ssget "X" '((8 . "M3P405-*")))) (if ss (command "_.ERASE" ss ""))
  (M3P405:draw) (command "_.ZOOM" "_E") (M3P405:restorevars) (setq *error* *M3P405-OLDERR*)
  (princ "\nM3-PRT-405 R0 gerada. Execute M3_PRT_405_AUDITAR.") (princ))
(defun C:M3_PRT_405_AUDITAR (/ ss n ok)
  (setq ss (ssget "X" '((8 . "M3P405-*"))) n (if ss (sslength ss) 0))
  (setq ok (and (> n 120) (tblsearch "LAYER" "M3P405-CONTORNO")
    (tblsearch "LAYER" "M3P405-COTA") (tblsearch "LAYER" "M3P405-HACHURA")))
  (princ "\n--- AUDITORIA M3-PRT-405 ---") (princ (strcat "\nEntidades M3P405: " (itoa n)))
  (princ "\nGeometria: 10 g6 x 32; 2x M5-6H prof.7; chanfros 0.5x45.")
  (princ "\nInterface: planeta/placas 10 H7; lote casado P403/P404/P405.")
  (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-405 carregada. Comandos: M3_PRT_405_GERAR e M3_PRT_405_AUDITAR.")
(princ)
