(defun C:M3_PRT_406_GERAR (/ ss)
  (M3P406:savevars) (setq *M3P406-OLDERR* *error* *error* M3P406:error)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
  (M3P406:layer "M3P406-MARGEM" 7 "Continuous" 50) (M3P406:layer "M3P406-CARIMBO" 7 "Continuous" 25)
  (M3P406:layer "M3P406-CONTORNO" 7 "Continuous" 50) (M3P406:layer "M3P406-COTA" 2 "Continuous" 25)
  (M3P406:layer "M3P406-TEXTO" 7 "Continuous" 25) (M3P406:layer "M3P406-EIXO" 4 "CENTER2" 25)
  (M3P406:layer "M3P406-OCULTA" 3 "HIDDEN2" 25) (M3P406:layer "M3P406-HACHURA" 8 "Continuous" 18)
  (M3P406:layer "M3P406-TABELA" 7 "Continuous" 25)
  (setq ss (ssget "X" '((8 . "M3P406-*")))) (if ss (command "_.ERASE" ss ""))
  (M3P406:draw) (command "_.ZOOM" "_E") (M3P406:restorevars) (setq *error* *M3P406-OLDERR*)
  (princ "\nM3-PRT-406 R1 gerada. Execute M3_PRT_406_AUDITAR.") (princ))
(defun C:M3_PRT_406_AUDITAR (/ ss n ok)
  (setq ss (ssget "X" '((8 . "M3P406-*"))) n (if ss (sslength ss) 0))
  (setq ok (and (> n 120) (tblsearch "LAYER" "M3P406-CONTORNO")
    (tblsearch "LAYER" "M3P406-COTA") (tblsearch "LAYER" "M3P406-HACHURA")))
  (princ "\n--- AUDITORIA M3-PRT-406 ---") (princ (strcat "\nEntidades M3P406: " (itoa n)))
  (princ "\nGeometria: OD16; ID10.2 H11; espessura 2.35 +/-0.05; quantidade 8.")
  (princ "\nPilha nominal por planeta: 20 - 15 - 4.70 = 0.30 mm; 4 planetas.")
  (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-406 carregada. Comandos: M3_PRT_406_GERAR e M3_PRT_406_AUDITAR.")
(princ)
