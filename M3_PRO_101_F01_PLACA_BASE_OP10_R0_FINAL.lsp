(defun C:M3_PRO_101_F01_GERAR (/ ss)
 (M3P101F01:sv) (setq *M3P101F01-ERR* *error* *error* M3P101F01:er)
 (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (foreach a '(("M3P101F01-BORDA" 7 "Continuous" 50)("M3P101F01-TABELA" 7 "Continuous" 25)("M3P101F01-TEXTO" 7 "Continuous" 25)("M3P101F01-CODIGO" 1 "Continuous" 35)("M3P101F01-BRUTO" 8 "Continuous" 50)("M3P101F01-ACABADO" 3 "HIDDEN2" 25)("M3P101F01-COTA" 2 "Continuous" 25)("M3P101F01-FERRAMENTA" 1 "Continuous" 50)("M3P101F01-AVANCO" 4 "Continuous" 35)) (M3P101F01:lay (car a) (cadr a) (caddr a) (cadddr a)))
 (setq ss (ssget "X" '((8 . "M3P101F01-*")))) (if ss (command "_.ERASE" ss ""))
 (M3P101F01:draw) (command "_.ZOOM" "_E") (M3P101F01:rv) (setq *error* *M3P101F01-ERR*)
 (princ "\nM3-PRO-101-F01 gerada. Execute M3_PRO_101_F01_AUDITAR.") (princ))
(defun C:M3_PRO_101_F01_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P101F01-*"))) n (if ss (sslength ss) 0))
 (setq ok (and (> n 120) (tblsearch "LAYER" "M3P101F01-CODIGO") (tblsearch "LAYER" "M3P101F01-FERRAMENTA") (tblsearch "LAYER" "M3P101F01-ACABADO")))
 (princ "\n--- AUDITORIA M3-PRO-101-F01 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nOperacao 10: materia-prima, corte 265x185x12, recursos, parametros, inspecao, tempo e seguranca.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRO-101-F01 carregada. Comandos: M3_PRO_101_F01_GERAR e M3_PRO_101_F01_AUDITAR.") (princ)
