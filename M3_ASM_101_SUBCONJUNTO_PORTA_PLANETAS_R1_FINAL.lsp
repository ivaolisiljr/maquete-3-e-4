(defun C:M3_ASM_101_GERAR(/ ss)
 (M3A101:savevars)(setq *M3A101-OLDERR* *error* *error* M3A101:error)(setvar "CMDECHO" 0)(setvar "OSMODE" 0)(setvar "ORTHOMODE" 0)(setvar "INSUNITS" 4)
 (M3A101:layer "M3A101-MARGEM" 7 "Continuous" 50)(M3A101:layer "M3A101-CARIMBO" 7 "Continuous" 25)(M3A101:layer "M3A101-CONTORNO" 7 "Continuous" 50)
 (M3A101:layer "M3A101-TEXTO" 7 "Continuous" 25)(M3A101:layer "M3A101-EIXO" 4 "CENTER2" 25)(M3A101:layer "M3A101-TABELA" 7 "Continuous" 25)
 (setq ss(ssget "X" '((8 . "M3A101-*"))))(if ss(command "_.ERASE" ss ""))(M3A101:draw)(command "_.ZOOM" "_E")(M3A101:restorevars)(setq *error* *M3A101-OLDERR*)
 (princ "\nM3-ASM-101 R1 gerada. Execute M3_ASM_101_AUDITAR.")(princ))
(defun C:M3_ASM_101_AUDITAR(/ ss n ok)
 (setq ss(ssget "X" '((8 . "M3A101-*"))) n(if ss(sslength ss)0))(setq ok(and(> n 80)(tblsearch "LAYER" "M3A101-CONTORNO")))
 (princ "\n--- AUDITORIA M3-ASM-101 ---")(princ(strcat "\nEntidades: "(itoa n)))(princ "\nBOM: 2 placas R1, 1 cubo, 4 planetas, 4 pinos, 8 espacadores.")
 (if ok(princ "\nRESULTADO ESTATICO: APROVADO.")(princ "\nRESULTADO: REPROVADO."))(princ))
(princ "\nM3-ASM-101 carregada. Comandos: M3_ASM_101_GERAR e M3_ASM_101_AUDITAR.")(princ)
