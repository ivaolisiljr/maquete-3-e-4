(defun C:M3_PRT_702_GERAR (/ ss)
 (M3P702:savevars) (setq *M3P702-OLDERR* *error* *error* M3P702:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P702:layer "M3P702-MARGEM" 7 "Continuous" 50) (M3P702:layer "M3P702-CARIMBO" 7 "Continuous" 25) (M3P702:layer "M3P702-CONTORNO" 7 "Continuous" 50)
 (M3P702:layer "M3P702-COTA" 2 "Continuous" 25) (M3P702:layer "M3P702-TEXTO" 7 "Continuous" 25) (M3P702:layer "M3P702-DOBRA" 4 "CENTER2" 25) (M3P702:layer "M3P702-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P702-*")))) (if ss (command "_.ERASE" ss "")) (M3P702:draw) (command "_.ZOOM" "_E") (M3P702:restorevars) (setq *error* *M3P702-OLDERR*)
 (princ "\nM3-PRT-702 R0 gerada. Execute M3_PRT_702_AUDITAR.") (princ))
(defun C:M3_PRT_702_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P702-*"))) n (if ss (sslength ss) 0)) (setq ok (and (> n 75) (tblsearch "LAYER" "M3P702-CONTORNO") (tblsearch "LAYER" "M3P702-DOBRA")))
 (princ "\n--- AUDITORIA M3-PRT-702 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: desenvolvimento240x180x4; topo160; abas40; 6 rasgos5.5x12.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-702 carregada. Comandos: M3_PRT_702_GERAR e M3_PRT_702_AUDITAR.") (princ)
