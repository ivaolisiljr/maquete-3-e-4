; M3-ASM-000 - CONJUNTO GERAL M3-PLN - R0 FINAL DE PROTOTIPO
; AutoCAD Mechanical 2025 PT-BR / A3 horizontal / mm
; Comandos: M3_ASM_000_GERAR e M3_ASM_000_AUDITAR
; Conjunto geral: base, pedestais, carcaca, tampas, eixos, trem 4 planetas, manivela e protecao.
(vl-load-com)
(setq *M3G000-OLDERR* nil *M3G000-OLDVARS* nil)
(defun M3G000:savevars () (setq *M3G000-OLDVARS* (mapcar '(lambda(n)(cons n(getvar n))) '("CMDECHO" "OSMODE" "ORTHOMODE" "CLAYER" "INSUNITS"))))
(defun M3G000:restorevars () (if *M3G000-OLDVARS* (foreach p *M3G000-OLDVARS* (if(cdr p)(setvar(car p)(cdr p))))) (setq *M3G000-OLDVARS* nil))
(defun M3G000:error(m)(M3G000:restorevars)(if(and m(/= m "Function cancelled"))(princ(strcat "\nM3-ASM-000 ERRO: " m)))(setq *error* *M3G000-OLDERR*)(princ))
(defun M3G000:layer(n c lt lw)(if(not(tblsearch "LAYER" n))(entmake(list '(0 . "LAYER")'(100 . "AcDbSymbolTableRecord")'(100 . "AcDbLayerTableRecord")(cons 2 n)(cons 70 0)(cons 62 c)(cons 6 lt)(cons 370 lw)))))
(defun M3G000:line(a b l)(entmake(list '(0 . "LINE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbLine")(cons 10 a)(cons 11 b))))
(defun M3G000:circle(c r l)(entmake(list '(0 . "CIRCLE")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbCircle")(cons 10 c)(cons 40 r))))
(defun M3G000:text(p h x l)(entmake(list '(0 . "TEXT")'(100 . "AcDbEntity")(cons 8 l)'(100 . "AcDbText")(cons 10 p)(cons 40 h)(cons 1 x)(cons 7 "Standard"))))
(defun M3G000:rect(x1 y1 x2 y2 l)(M3G000:line(list x1 y1 0)(list x2 y1 0)l)(M3G000:line(list x2 y1 0)(list x2 y2 0)l)(M3G000:line(list x2 y2 0)(list x1 y2 0)l)(M3G000:line(list x1 y2 0)(list x1 y1 0)l))
