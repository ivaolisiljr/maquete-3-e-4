(defun C:M3_PRT_701_GERAR (/ ss)
 (M3P701:savevars) (setq *M3P701-OLDERR* *error* *error* M3P701:error) (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "ORTHOMODE" 0) (setvar "INSUNITS" 4)
 (M3P701:layer "M3P701-MARGEM" 7 "Continuous" 50) (M3P701:layer "M3P701-CARIMBO" 7 "Continuous" 25) (M3P701:layer "M3P701-CONTORNO" 7 "Continuous" 50)
 (M3P701:layer "M3P701-COTA" 2 "Continuous" 25) (M3P701:layer "M3P701-TEXTO" 7 "Continuous" 25) (M3P701:layer "M3P701-EIXO" 4 "CENTER2" 25) (M3P701:layer "M3P701-TABELA" 7 "Continuous" 25)
 (setq ss (ssget "X" '((8 . "M3P701-*")))) (if ss (command "_.ERASE" ss "")) (M3P701:draw) (command "_.ZOOM" "_E") (M3P701:restorevars) (setq *error* *M3P701-OLDERR*)
 (princ "\nM3-PRT-701 R0 gerada. Execute M3_PRT_701_AUDITAR.") (princ))
(defun C:M3_PRT_701_AUDITAR (/ ss n ok)
 (setq ss (ssget "X" '((8 . "M3P701-*"))) n (if ss (sslength ss) 0)) (setq ok (and (> n 85) (tblsearch "LAYER" "M3P701-CONTORNO")))
 (princ "\n--- AUDITORIA M3-PRT-701 ---") (princ (strcat "\nEntidades: " (itoa n)))
 (princ "\nGeometria: braco140x25x8; cubo30x18; furo12H7; raio100; manopulo25x80.")
 (if ok (princ "\nRESULTADO ESTATICO: APROVADO.") (princ "\nRESULTADO: REPROVADO.")) (princ))
(princ "\nM3-PRT-701 carregada. Comandos: M3_PRT_701_GERAR e M3_PRT_701_AUDITAR.") (princ)
